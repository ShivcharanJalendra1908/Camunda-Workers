# ============================================================================
# .dockerignore - Exclude files from Docker build context
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/
.github/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
bin/
build/
dist/
*.exe
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.out
coverage.html
*.coverprofile

# Dependency directories
vendor/
node_modules/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Development files
docker-compose.yml
docker-compose.*.yml
Dockerfile*
!deployments/docker/Dockerfile.worker
!deployments/docker/Dockerfile.gateway
.air.toml

# CI/CD
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Test data
test/
testdata/
*_test.go

# Scripts (unless specifically needed)
scripts/
!scripts/migrate/

# Kubernetes (not needed in image)
deployments/kubernetes/
k8s/

# Miscellaneous
*.bak
*.backup
*.old