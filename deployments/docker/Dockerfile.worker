# ============================================================================
# Multi-stage Dockerfile for Camunda Workers
# ============================================================================

# --- Stage 1: Builder ---
FROM golang:1.24-alpine AS builder

# Set Go proxy with fallbacks
ENV GOPROXY=https://goproxy.io,https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org
ENV GO111MODULE=on

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    gcc \
    musl-dev \
    ca-certificates \
    tzdata\
    file

# Set working directory
WORKDIR /build

# Copy go mod files first (better layer caching)
COPY go.mod go.sum ./

# Download and verify dependencies
RUN go mod download && go mod verify

# Copy entire source code
COPY . .

# Build arguments for versioning
ARG VERSION=dev
ARG COMMIT_HASH=unknown
ARG BUILD_TIME=unknown

# Build the worker-manager binary
# RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
RUN CGO_ENABLED=0 go build \
    -a \
    -installsuffix cgo \
    -ldflags="-w -s \
    -X main.version=${VERSION} \
    -X main.commit=${COMMIT_HASH} \
    -X main.date=${BUILD_TIME}" \
    -o worker-manager \
    ./cmd/worker-manager/main.go

# Verify binary was created
RUN ls -lh worker-manager && \
    file worker-manager && \
    echo "Binary size: $(du -h worker-manager | cut -f1)"

# --- Stage 2: Runtime ---
FROM alpine:3.18

LABEL maintainer="support@lemici.com"
LABEL description="Camunda 8 Workers for Franchise Workflow System"

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    wget \
    bash

# Create non-root user for security
RUN addgroup -g 1000 camunda && \
    adduser -D -u 1000 -G camunda camunda

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder --chown=camunda:camunda /build/worker-manager .

# Copy configuration files
COPY --from=builder --chown=camunda:camunda /build/configs/ configs/

# Copy BPMN definitions
COPY --from=builder --chown=camunda:camunda /build/bpmn/ bpmn/

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/data /app/tmp && \
    chown -R camunda:camunda /app && \
    chmod +x /app/worker-manager

# Switch to non-root user
USER camunda

# Expose ports
# 8082: Health check endpoint (changed from 8080 to avoid conflict with API Gateway)
# 9091: Metrics endpoint (changed from 9090 to avoid conflict with API Gateway)
EXPOSE 8082 9091

# Environment variables with defaults
ENV HEALTH_CHECK_PORT=8082
ENV METRICS_PORT=9091
ENV LOG_LEVEL=info
ENV APP_ENVIRONMENT=production

# Health check using environment variable
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${HEALTH_CHECK_PORT}/health || exit 1

# Set entrypoint
ENTRYPOINT ["./worker-manager"]

# Default command (can be overridden)
CMD []



