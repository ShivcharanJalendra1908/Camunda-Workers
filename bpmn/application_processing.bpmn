<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_franchise_application" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <bpmn:process id="WF_FRANCHISE_APPLICATION" name="Franchise Application Workflow" isExecutable="true">
    <bpmn:endEvent id="EndEvent_Application" name="Application Complete">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_BuildResponse" name="Build Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-response" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;application-success&#34;" target="templateId" />
          <zeebe:input source="=createdApplicationId" target="applicationId" />
          <zeebe:input source="=applicationStatus" target="status" />
          <zeebe:input source="=requestId" target="requestId" />
          <zeebe:output source="=response" target="workflowResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_build_response</bpmn:incoming>
      <bpmn:outgoing>Flow_from_build_response</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CallbackBFF" name="Callback to BFF">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-connector" />
        <zeebe:taskHeaders>
          <zeebe:header key="url" value="http://bff-service:8080/api/callback/{{requestId}}" />
          <zeebe:header key="method" value="POST" />
          <zeebe:header key="contentType" value="application/json" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=workflowResponse" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_callback</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckPriorityRouting" name="Check Priority Routing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-priority-routing" />
        <zeebe:ioMapping>
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=isPremiumFranchisor" target="isPremiumFranchisor" />
          <zeebe:output source="=routingPriority" target="routingPriority" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_priority_routing</bpmn:incoming>
      <bpmn:outgoing>Flow_to_create_record</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckReadinessScore" name="Check Readiness Score">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-readiness-score" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=cleanApplicationData" target="applicationData" />
          <zeebe:output source="=readinessScore" target="calculatedReadinessScore" />
          <zeebe:output source="=qualificationLevel" target="qualificationLevel" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_readiness</bpmn:incoming>
      <bpmn:outgoing>Flow_to_priority_routing</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendConfirmationToSeeker" name="Confirm to Seeker">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="recipientId" />
          <zeebe:input source="=&#34;seeker&#34;" target="recipientType" />
          <zeebe:input source="=&#34;application_submitted&#34;" target="notificationType" />
          <zeebe:input source="=createdApplicationId" target="applicationId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_seeker_notification</bpmn:incoming>
      <bpmn:outgoing>Flow_from_seeker_notification</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreateApplicationRecord" name="Create Application Record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-application-record" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="seekerId" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:input source="=cleanApplicationData" target="applicationData" />
          <zeebe:input source="=calculatedReadinessScore" target="readinessScore" />
          <zeebe:input source="=routingPriority" target="priority" />
          <zeebe:output source="=applicationId" target="createdApplicationId" />
          <zeebe:output source="=applicationStatus" target="applicationStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_create_record</bpmn:incoming>
      <bpmn:outgoing>Flow_to_parallel_notifications</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Error" name="Error End">
      <bpmn:incoming>Flow_to_error_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_from_build_response" sourceRef="Task_BuildResponse" targetRef="Gateway_NotificationsJoin" />
    <bpmn:sequenceFlow id="Flow_from_franchisor_notification" sourceRef="Task_SendNotificationToFranchisor" targetRef="Gateway_NotificationsJoin" />
    <bpmn:sequenceFlow id="Flow_from_seeker_notification" sourceRef="Task_SendConfirmationToSeeker" targetRef="Gateway_NotificationsJoin" />
    <bpmn:sequenceFlow id="Flow_to_build_response" sourceRef="Gateway_NotificationsSplit" targetRef="Task_BuildResponse" />
    <bpmn:sequenceFlow id="Flow_to_callback" sourceRef="Gateway_NotificationsJoin" targetRef="Task_CallbackBFF" />
    <bpmn:sequenceFlow id="Flow_to_create_record" sourceRef="Task_CheckPriorityRouting" targetRef="Task_CreateApplicationRecord" />
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Task_CallbackBFF" targetRef="EndEvent_Application" />
    <bpmn:sequenceFlow id="Flow_to_error_end" sourceRef="Error_InvalidData" targetRef="EndEvent_Error" />
    <bpmn:sequenceFlow id="Flow_to_franchisor_notification" sourceRef="Gateway_NotificationsSplit" targetRef="Task_SendNotificationToFranchisor" />
    <bpmn:sequenceFlow id="Flow_to_parallel_notifications" sourceRef="Task_CreateApplicationRecord" targetRef="Gateway_NotificationsSplit" />
    <bpmn:sequenceFlow id="Flow_to_priority_routing" sourceRef="Task_CheckReadinessScore" targetRef="Task_CheckPriorityRouting" />
    <bpmn:sequenceFlow id="Flow_to_readiness" sourceRef="Task_ValidateApplicationData" targetRef="Task_CheckReadinessScore" />
    <bpmn:sequenceFlow id="Flow_to_seeker_notification" sourceRef="Gateway_NotificationsSplit" targetRef="Task_SendConfirmationToSeeker" />
    <bpmn:sequenceFlow id="Flow_to_validate_data" sourceRef="Task_ValidateSubscription" targetRef="Task_ValidateApplicationData" />
    <bpmn:sequenceFlow id="Flow_to_validate_subscription" sourceRef="StartEvent_Application" targetRef="Task_ValidateSubscription" />
    <bpmn:boundaryEvent id="Error_InvalidData" name="Invalid Data" attachedToRef="Task_ValidateApplicationData">
      <bpmn:outgoing>Flow_to_error_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_ValidationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Gateway_NotificationsJoin" name="Join">
      <bpmn:incoming>Flow_from_franchisor_notification</bpmn:incoming>
      <bpmn:incoming>Flow_from_seeker_notification</bpmn:incoming>
      <bpmn:incoming>Flow_from_build_response</bpmn:incoming>
      <bpmn:outgoing>Flow_to_callback</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SendNotificationToFranchisor" name="Notify Franchisor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:input source="=franchiseId" target="recipientId" />
          <zeebe:input source="=&#34;franchisor&#34;" target="recipientType" />
          <zeebe:input source="=&#34;new_application&#34;" target="notificationType" />
          <zeebe:input source="=createdApplicationId" target="applicationId" />
          <zeebe:input source="=routingPriority" target="priority" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_franchisor_notification</bpmn:incoming>
      <bpmn:outgoing>Flow_from_franchisor_notification</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_NotificationsSplit" name="Send Notifications">
      <bpmn:incoming>Flow_to_parallel_notifications</bpmn:incoming>
      <bpmn:outgoing>Flow_to_franchisor_notification</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_seeker_notification</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_build_response</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:startEvent id="StartEvent_Application" name="Start Application">
      <bpmn:outgoing>Flow_to_validate_subscription</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateApplicationData" name="Validate Application Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-application-data" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationData" target="applicationData" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=isValid" target="dataValid" />
          <zeebe:output source="=validatedData" target="cleanApplicationData" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_validate_data</bpmn:incoming>
      <bpmn:outgoing>Flow_to_readiness</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidateSubscription" name="Validate Subscription">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-subscription" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=subscriptionTier" target="subscriptionTier" />
          <zeebe:output source="=isValid" target="subscriptionValid" />
          <zeebe:output source="=tierLevel" target="validatedTier" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_validate_subscription</bpmn:incoming>
      <bpmn:outgoing>Flow_to_validate_data</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:error id="Error_ValidationFailed" name="ValidationFailed" errorCode="APPLICATION_VALIDATION_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="WF_FRANCHISE_APPLICATION">
      <bpmndi:BPMNShape id="StartEvent_Application_di" bpmnElement="StartEvent_Application">
        <dc:Bounds x="232" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="211" y="125" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateSubscription_di" bpmnElement="Task_ValidateSubscription">
        <dc:Bounds x="300" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateApplicationData_di" bpmnElement="Task_ValidateApplicationData">
        <dc:Bounds x="460" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Error_di" bpmnElement="EndEvent_Error">
        <dc:Bounds x="782" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="778" y="305" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckReadinessScore_di" bpmnElement="Task_CheckReadinessScore">
        <dc:Bounds x="300" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateApplicationRecord_di" bpmnElement="Task_CreateApplicationRecord">
        <dc:Bounds x="300" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NotificationsSplit_di" bpmnElement="Gateway_NotificationsSplit">
        <dc:Bounds x="225" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="652" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendNotificationToFranchisor_di" bpmnElement="Task_SendNotificationToFranchisor">
        <dc:Bounds x="370" y="580" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendConfirmationToSeeker_di" bpmnElement="Task_SendConfirmationToSeeker">
        <dc:Bounds x="370" y="700" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildResponse_di" bpmnElement="Task_BuildResponse">
        <dc:Bounds x="370" y="820" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NotificationsJoin_di" bpmnElement="Gateway_NotificationsJoin">
        <dc:Bounds x="575" y="695" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="733" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CallbackBFF_di" bpmnElement="Task_CallbackBFF">
        <dc:Bounds x="740" y="680" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Application_di" bpmnElement="EndEvent_Application">
        <dc:Bounds x="942" y="702" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="934" y="745" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPriorityRouting_di" bpmnElement="Task_CheckPriorityRouting">
        <dc:Bounds x="480" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Error_InvalidData_di" bpmnElement="Error_InvalidData">
        <dc:Bounds x="562" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="553" y="305" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_validate_subscription_di" bpmnElement="Flow_to_validate_subscription">
        <di:waypoint x="250" y="118" />
        <di:waypoint x="250" y="240" />
        <di:waypoint x="300" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_validate_data_di" bpmnElement="Flow_to_validate_data">
        <di:waypoint x="420" y="240" />
        <di:waypoint x="460" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_readiness_di" bpmnElement="Flow_to_readiness">
        <di:waypoint x="520" y="280" />
        <di:waypoint x="520" y="300" />
        <di:waypoint x="360" y="300" />
        <di:waypoint x="360" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_error_end_di" bpmnElement="Flow_to_error_end">
        <di:waypoint x="598" y="280" />
        <di:waypoint x="782" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_priority_routing_di" bpmnElement="Flow_to_priority_routing">
        <di:waypoint x="420" y="360" />
        <di:waypoint x="480" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_create_record_di" bpmnElement="Flow_to_create_record">
        <di:waypoint x="540" y="400" />
        <di:waypoint x="540" y="480" />
        <di:waypoint x="420" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_parallel_notifications_di" bpmnElement="Flow_to_parallel_notifications">
        <di:waypoint x="300" y="480" />
        <di:waypoint x="250" y="480" />
        <di:waypoint x="250" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_franchisor_notification_di" bpmnElement="Flow_to_franchisor_notification">
        <di:waypoint x="275" y="620" />
        <di:waypoint x="370" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_seeker_notification_di" bpmnElement="Flow_to_seeker_notification">
        <di:waypoint x="250" y="645" />
        <di:waypoint x="250" y="740" />
        <di:waypoint x="370" y="740" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_build_response_di" bpmnElement="Flow_to_build_response">
        <di:waypoint x="250" y="645" />
        <di:waypoint x="250" y="860" />
        <di:waypoint x="370" y="860" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_from_franchisor_notification_di" bpmnElement="Flow_from_franchisor_notification">
        <di:waypoint x="490" y="620" />
        <di:waypoint x="600" y="620" />
        <di:waypoint x="600" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_from_seeker_notification_di" bpmnElement="Flow_from_seeker_notification">
        <di:waypoint x="490" y="720" />
        <di:waypoint x="575" y="720" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_from_build_response_di" bpmnElement="Flow_from_build_response">
        <di:waypoint x="490" y="860" />
        <di:waypoint x="600" y="860" />
        <di:waypoint x="600" y="745" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_callback_di" bpmnElement="Flow_to_callback">
        <di:waypoint x="625" y="720" />
        <di:waypoint x="740" y="720" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_end_di" bpmnElement="Flow_to_end">
        <di:waypoint x="860" y="720" />
        <di:waypoint x="942" y="720" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
