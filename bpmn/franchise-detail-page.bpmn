      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BuildResponse" bpmnElement="Task_BuildResponse">
        <dc:Bounds x="820" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendResponse" bpmnElement="Task_SendResponse">
        <dc:Bounds x="980" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Detail" bpmnElement="End_Detail">
        <dc:Bounds x="1152" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1133" y="405" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryEvent_BasicError" bpmnElement="BoundaryEvent_BasicError">
        <dc:Bounds x="282" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_To_Basic" bpmnElement="Flow_Start_To_Basic">
        <di:waypoint x="188" y="380" />
        <di:waypoint x="240" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_BasicError_To_ErrorHandler" bpmnElement="Flow_BasicError_To_ErrorHandler">
        <di:waypoint x="299" y="438" />
        <di:waypoint x="299" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_ErrorEnd" bpmnElement="Flow_To_ErrorEnd">
        <di:waypoint x="301" y="530" />
        <di:waypoint x="301" y="562" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_Fork" bpmnElement="Flow_To_Fork">
        <di:waypoint x="360" y="380" />
        <di:waypoint x="410" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_Overview" bpmnElement="Flow_To_Overview">
        <di:waypoint x="435" y="355" />
        <di:waypoint x="435" y="102" />
        <di:waypoint x="510" y="102" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_Business" bpmnElement="Flow_To_Business">
        <di:waypoint x="435" y="355" />
        <di:waypoint x="435" y="178" />
        <di:waypoint x="510" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_Investment" bpmnElement="Flow_To_Investment">
        <di:waypoint x="435" y="355" />
        <di:waypoint x="435" y="250" />
        <di:waypoint x="510" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_Operations" bpmnElement="Flow_To_Operations">
