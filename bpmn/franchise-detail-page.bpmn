      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Error" bpmnElement="End_Error">
        <dc:Bounds x="283" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="262" y="606" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_GetCategories" bpmnElement="Task_GetCategories">
        <dc:Bounds x="510" y="433" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join">
        <dc:Bounds x="715" y="355" width="50" height="50" />
