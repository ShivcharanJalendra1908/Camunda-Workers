<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_detail" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <bpmn:error id="Error_QueryTimeout" name="QueryTimeoutError" />
  <bpmn:error id="Error_FranchiseNotFound" name="FranchiseNotFoundError" />
  <bpmn:error id="Error_DatabaseError" name="DatabaseError" />
  <bpmn:process id="franchise-detail-page" name="Franchise Detail Page" isExecutable="true">
    <bpmn:startEvent id="Start_Detail" name="Detail Request">
      <bpmn:outgoing>Flow_Start_To_Basic</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_GetBasic" name="Get Basic Info by Slug">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-elasticsearch" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="30000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_BY_SLUG&#34;" target="queryType" />
          <zeebe:input source="=slug" target="slug" />
          <zeebe:input source="=slug" target="franchiseId" />
          <zeebe:output source="=data[1]" target="basicInfo" />
          <zeebe:output source="=if data != null and count(data) > 0 then data[1].id else slug" target="franchiseId" />
          <zeebe:output source="=if data != null and count(data) > 0 and data[1].industry != null then data[1].industry.id else null" target="industryId" /> 
          <zeebe:output source="=if data != null and count(data) > 0 and data[1].industry != null then data[1].industry.slug else null" target="industrySlug" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Basic</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Fork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_BasicError" attachedToRef="Task_GetBasic">
      <bpmn:outgoing>Flow_BasicError_To_ErrorHandler</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_QueryTimeout" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ErrorHandler" name="Handle Error and Send Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-api-response" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={&#34;error&#34;: &#34;Failed to fetch franchise details. Please try again.&#34;, &#34;status&#34;: 500}" target="response" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BasicError_To_ErrorHandler</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ErrorEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Error" name="Error Response Sent">
      <bpmn:incoming>Flow_To_ErrorEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Fan Out">
      <bpmn:incoming>Flow_To_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Overview</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Business</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Investment</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Operations</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Social</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Categories</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Recommended</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Insights</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Questions</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_GetOverview" name="Get Franchise Overview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="15000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_OVERVIEW&#34;" target="queryType" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="overview" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Overview</bpmn:incoming>
      <bpmn:outgoing>Flow_Overview_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetBusiness" name="Get Business Overview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="15000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_BUSINESS&#34;" target="queryType" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="business" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Business</bpmn:incoming>
      <bpmn:outgoing>Flow_Business_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetInvestment" name="Get Investment Details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="15000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_INVESTMENT&#34;" target="queryType" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="investment" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Investment</bpmn:incoming>
      <bpmn:outgoing>Flow_Investment_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetOperations" name="Get Operations Details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="15000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_OPERATIONS&#34;" target="queryType" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="operations" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Operations</bpmn:incoming>
      <bpmn:outgoing>Flow_Operations_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetSocial" name="Get Social Links">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="10000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FRANCHISE_SOCIAL&#34;" target="queryType" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="social" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Social</bpmn:incoming>
      <bpmn:outgoing>Flow_Social_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetCategories" name="Get Featured Categories">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="10000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CATEGORIES_FEATURED_8&#34;" target="queryType" />
          <zeebe:output source="=data" target="categories" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Categories</bpmn:incoming>
      <bpmn:outgoing>Flow_Categories_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetRecommended" name="Get Recommended Franchises">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-elasticsearch" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="20000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;RECOMMENDED&#34;" target="queryType" />
          <zeebe:input source="=industrySlug" target="industrySlug" />
          <zeebe:input source="=franchiseId" target="franchiseId" />
          <zeebe:output source="=data" target="recommended" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Recommended</bpmn:incoming>
      <bpmn:outgoing>Flow_Recommended_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetInsights" name="Get Market Insights">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-elasticsearch" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="20000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MARKET_INSIGHTS&#34;" target="queryType" />
          <zeebe:input source="=industrySlug" target="industrySlug" />
          <zeebe:input source="=industryId" target="industryId" />
          <zeebe:output source="=if data != null and count(data) > 0 then data[1] else null" target="marketInsights" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Insights</bpmn:incoming>
      <bpmn:outgoing>Flow_Insights_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetQuestions" name="Get Category Questions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="15000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CATEGORY_QUESTIONS_BY_INDUSTRY&#34;" target="queryType" />
          <zeebe:input source="=industryId" target="industryId" />
           <zeebe:input source="=industrySlug" target="industrySlug" />
            <zeebe:input source="={&#34;industryId&#34;: industryId, &#34;industrySlug&#34;: industrySlug}" target="params" />
          <zeebe:output source="=data" target="categoryQuestions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Questions</bpmn:incoming>
      <bpmn:outgoing>Flow_Questions_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join" name="Join All">
      <bpmn:incoming>Flow_Overview_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Business_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Investment_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Operations_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Social_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Categories_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Recommended_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Insights_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Questions_To_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Build</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_BuildResponse" name="Build Detail Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-response" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="10000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="=&#34;detail&#34;" target="pageType" />
          <zeebe:input source="=basicInfo" target="basicInfo" />
          <zeebe:input source="=overview" target="overview" />
          <zeebe:input source="=business" target="business" />
          <zeebe:input source="=investment" target="investment" />
          <zeebe:input source="=operations" target="operations" />
          <zeebe:input source="=social" target="social" />
          <zeebe:input source="=categories" target="categories" />
          <zeebe:input source="=recommended" target="recommended" />
          <zeebe:input source="=if marketInsights != null then [marketInsights] else []" target="marketInsights" />
          <zeebe:input source="=categoryQuestions" target="categoryQuestions" />
          <zeebe:output source="=response" target="finalResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Build</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Send</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendResponse" name="Send API Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-api-response" />
        <zeebe:taskHeaders>
          <zeebe:header key="timeout" value="5000" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="=finalResponse" target="response" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Detail" name="Response Sent">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Basic" sourceRef="Start_Detail" targetRef="Task_GetBasic" />
    <bpmn:sequenceFlow id="Flow_BasicError_To_ErrorHandler" sourceRef="BoundaryEvent_BasicError" targetRef="Task_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_To_ErrorEnd" sourceRef="Task_ErrorHandler" targetRef="End_Error" />
    <bpmn:sequenceFlow id="Flow_To_Fork" sourceRef="Task_GetBasic" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_To_Overview" sourceRef="Gateway_Fork" targetRef="Task_GetOverview" />
    <bpmn:sequenceFlow id="Flow_To_Business" sourceRef="Gateway_Fork" targetRef="Task_GetBusiness" />
    <bpmn:sequenceFlow id="Flow_To_Investment" sourceRef="Gateway_Fork" targetRef="Task_GetInvestment" />
    <bpmn:sequenceFlow id="Flow_To_Operations" sourceRef="Gateway_Fork" targetRef="Task_GetOperations" />
    <bpmn:sequenceFlow id="Flow_To_Social" sourceRef="Gateway_Fork" targetRef="Task_GetSocial" />
    <bpmn:sequenceFlow id="Flow_To_Categories" sourceRef="Gateway_Fork" targetRef="Task_GetCategories" />
    <bpmn:sequenceFlow id="Flow_To_Recommended" sourceRef="Gateway_Fork" targetRef="Task_GetRecommended" />
    <bpmn:sequenceFlow id="Flow_To_Insights" sourceRef="Gateway_Fork" targetRef="Task_GetInsights" />
    <bpmn:sequenceFlow id="Flow_To_Questions" sourceRef="Gateway_Fork" targetRef="Task_GetQuestions" />
    <bpmn:sequenceFlow id="Flow_Overview_To_Join" sourceRef="Task_GetOverview" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Business_To_Join" sourceRef="Task_GetBusiness" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Investment_To_Join" sourceRef="Task_GetInvestment" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Operations_To_Join" sourceRef="Task_GetOperations" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Social_To_Join" sourceRef="Task_GetSocial" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Categories_To_Join" sourceRef="Task_GetCategories" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Recommended_To_Join" sourceRef="Task_GetRecommended" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Insights_To_Join" sourceRef="Task_GetInsights" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Questions_To_Join" sourceRef="Task_GetQuestions" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_To_Build" sourceRef="Gateway_Join" targetRef="Task_BuildResponse" />
    <bpmn:sequenceFlow id="Flow_To_Send" sourceRef="Task_BuildResponse" targetRef="Task_SendResponse" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_SendResponse" targetRef="End_Detail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Detail">
    <bpmndi:BPMNPlane id="Plane_Detail" bpmnElement="franchise-detail-page">
      <bpmndi:BPMNShape id="Shape_Start_Detail" bpmnElement="Start_Detail">
        <dc:Bounds x="152" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
