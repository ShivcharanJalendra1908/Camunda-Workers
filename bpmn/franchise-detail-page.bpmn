        <dc:Bounds x="510" y="360" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_GetRecommended" bpmnElement="Task_GetRecommended">
        <dc:Bounds x="510" y="504" width="120" height="60" />
