<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:process id="franchise-complete-registration" name="Franchise Complete Registration" isExecutable="true">
    
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1: Create Main Franchise Record -->
    <bpmn:serviceTask id="CreateFranchise" name="Create Franchise">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_FRANCHISE&#34;" target="operation_type" />
          <zeebe:input source="=name" target="name" />
          <zeebe:input source="=slug" target="slug" />
          <zeebe:input source="=founded_year" target="founded_year" />
          <zeebe:input source="=industry" target="industry" />
          <zeebe:input source="=description" target="description" />
          <zeebe:input source="=user_id" target="created_by" />
          <zeebe:output source="=franchise_id" target="franchise_id" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 2: Create Business Overview -->
    <bpmn:serviceTask id="CreateBusinessOverview" name="Create Business Overview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_BUSINESS_OVERVIEW&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=products" target="products" />
          <zeebe:input source="=services" target="services" />
          <zeebe:input source="=user_id" target="created_by" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 3: Create Investment Requirements -->
    <bpmn:serviceTask id="CreateInvestment" name="Create Investment Requirements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_INVESTMENT&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=initial_investment_min" target="initial_investment_min" />
          <zeebe:input source="=initial_investment_max" target="initial_investment_max" />
          <zeebe:input source="=franchise_fee" target="franchise_fee" />
          <zeebe:input source="=royalty_percentage" target="royalty_percentage" />
          <zeebe:input source="=user_id" target="created_by" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 4: Create Operations Info -->
    <bpmn:serviceTask id="CreateOperations" name="Create Operations Info">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_OPERATIONS&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=space_min_sqft" target="space_min_sqft" />
          <zeebe:input source="=space_max_sqft" target="space_max_sqft" />
          <zeebe:input source="=training_provided" target="training_provided" />
          <zeebe:input source="=training_details" target="training_details" />
          <zeebe:input source="=user_id" target="created_by" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent" name="Franchise Created">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent" targetRef="CreateFranchise" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CreateFranchise" targetRef="CreateBusinessOverview" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CreateBusinessOverview" targetRef="CreateInvestment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="CreateInvestment" targetRef="CreateOperations" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="CreateOperations" targetRef="EndEvent" />

  </bpmn:process>

  <!-- Admin Update Workflow -->
  <bpmn:process id="franchise-admin-update" name="Franchise Admin Update" isExecutable="true">
    
    <bpmn:startEvent id="StartUpdate" name="Start Update">
      <bpmn:outgoing>FlowUpdate_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Update Franchise -->
    <bpmn:serviceTask id="UpdateFranchise" name="Update Franchise">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_FRANCHISE&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=admin_id" target="updated_by" />
          <zeebe:input source="=name" target="name" />
          <zeebe:input source="=description" target="description" />
          <zeebe:input source="=trusted_seller" target="trusted_seller" />
          <zeebe:output source="=success" target="update_success" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>FlowUpdate_1</bpmn:incoming>
      <bpmn:outgoing>FlowUpdate_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndUpdate" name="Update Complete">
      <bpmn:incoming>FlowUpdate_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="FlowUpdate_1" sourceRef="StartUpdate" targetRef="UpdateFranchise" />
    <bpmn:sequenceFlow id="FlowUpdate_2" sourceRef="UpdateFranchise" targetRef="EndUpdate" />

  </bpmn:process>

</bpmn:definitions>