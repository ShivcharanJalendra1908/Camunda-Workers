<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" 
                  exporterVersion="5.38.1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.0.0">
  
  <bpmn:process id="franchise-mvp-workflow" name="Franchise MVP Workflow" isExecutable="true">
    
    <!-- START -->
    <bpmn:startEvent id="StartEvent_1" name="API Request">
      <bpmn:outgoing>Flow_start_to_router</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- MAIN ROUTER -->
    <bpmn:exclusiveGateway id="Gateway_MainRouter" name="Which Page?" default="Flow_default_error">
      <bpmn:incoming>Flow_start_to_router</bpmn:incoming>
      <bpmn:outgoing>Flow_to_home</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_listing</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_detail</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_ai_search</bpmn:outgoing>
      <bpmn:outgoing>Flow_default_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- ========================================== -->
    <!-- HOME PAGE FLOW - Parallel Execution -->
    <!-- ========================================== -->
    <bpmn:subProcess id="SubProcess_HomePage" name="HOME PAGE">
      <bpmn:incoming>Flow_to_home</bpmn:incoming>
      <bpmn:outgoing>Flow_home_to_merge</bpmn:outgoing>
      
      <bpmn:startEvent id="Event_Home_Start">
        <bpmn:outgoing>Flow_home_start_parallel</bpmn:outgoing>
      </bpmn:startEvent>
      
      <!-- Parallel Gateway Start - All tasks run simultaneously -->
      <bpmn:parallelGateway id="Gateway_Home_Parallel_Start">
        <bpmn:incoming>Flow_home_start_parallel</bpmn:incoming>
        <bpmn:outgoing>Flow_to_hero_brands</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_popular_listings</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_top_industries</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_top_categories</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <!-- Task 1: Hero Brands (Elasticsearch) -->
      <bpmn:serviceTask id="Task_Home_HeroBrands" name="Query ES:&#10;Hero Brands">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-elasticsearch" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="ES_HERO_BRANDS" />
            <zeebe:header key="index" value="franchises" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_hero_brands</bpmn:incoming>
        <bpmn:outgoing>Flow_hero_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 2: Popular Listings (Elasticsearch) -->
      <bpmn:serviceTask id="Task_Home_PopularListings" name="Query ES:&#10;Popular Listings">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-elasticsearch" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="ES_POPULAR_LISTINGS" />
            <zeebe:header key="index" value="franchises" />
            <zeebe:header key="sort" value="popularity" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_popular_listings</bpmn:incoming>
        <bpmn:outgoing>Flow_popular_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 3: Top 9 Industries (PostgreSQL) -->
      <bpmn:serviceTask id="Task_Home_TopIndustries" name="Query PG:&#10;Top 9 Industries">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="industries_top_9" />
            <zeebe:header key="orderBy" value="franchise_count DESC" />
            <zeebe:header key="limit" value="9" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_top_industries</bpmn:incoming>
        <bpmn:outgoing>Flow_industries_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 4: Top 30 Categories (PostgreSQL) -->
      <bpmn:serviceTask id="Task_Home_TopCategories" name="Query PG:&#10;Top 30 Categories">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="categories_top_30" />
            <zeebe:header key="orderBy" value="popularity DESC" />
            <zeebe:header key="limit" value="30" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_top_categories</bpmn:incoming>
        <bpmn:outgoing>Flow_categories_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Parallel Gateway End - Wait for all tasks -->
      <bpmn:parallelGateway id="Gateway_Home_Parallel_End">
        <bpmn:incoming>Flow_hero_done</bpmn:incoming>
        <bpmn:incoming>Flow_popular_done</bpmn:incoming>
        <bpmn:incoming>Flow_industries_done</bpmn:incoming>
        <bpmn:incoming>Flow_categories_done</bpmn:incoming>
        <bpmn:outgoing>Flow_home_end</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <bpmn:endEvent id="Event_Home_End">
        <bpmn:incoming>Flow_home_end</bpmn:incoming>
      </bpmn:endEvent>
      
      <!-- Home Page Internal Flows -->
      <bpmn:sequenceFlow id="Flow_home_start_parallel" sourceRef="Event_Home_Start" targetRef="Gateway_Home_Parallel_Start" />
      <bpmn:sequenceFlow id="Flow_to_hero_brands" sourceRef="Gateway_Home_Parallel_Start" targetRef="Task_Home_HeroBrands" />
      <bpmn:sequenceFlow id="Flow_to_popular_listings" sourceRef="Gateway_Home_Parallel_Start" targetRef="Task_Home_PopularListings" />
      <bpmn:sequenceFlow id="Flow_to_top_industries" sourceRef="Gateway_Home_Parallel_Start" targetRef="Task_Home_TopIndustries" />
      <bpmn:sequenceFlow id="Flow_to_top_categories" sourceRef="Gateway_Home_Parallel_Start" targetRef="Task_Home_TopCategories" />
      <bpmn:sequenceFlow id="Flow_hero_done" sourceRef="Task_Home_HeroBrands" targetRef="Gateway_Home_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_popular_done" sourceRef="Task_Home_PopularListings" targetRef="Gateway_Home_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_industries_done" sourceRef="Task_Home_TopIndustries" targetRef="Gateway_Home_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_categories_done" sourceRef="Task_Home_TopCategories" targetRef="Gateway_Home_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_home_end" sourceRef="Gateway_Home_Parallel_End" targetRef="Event_Home_End" />
    </bpmn:subProcess>
    
    <!-- ========================================== -->
    <!-- LISTING PAGE FLOW - Sequential + Parallel -->
    <!-- ========================================== -->
    <bpmn:subProcess id="SubProcess_ListingPage" name="LISTING PAGE (Golf/Industry)">
      <bpmn:incoming>Flow_to_listing</bpmn:incoming>
      <bpmn:outgoing>Flow_listing_to_merge</bpmn:outgoing>
      
      <bpmn:startEvent id="Event_Listing_Start">
        <bpmn:outgoing>Flow_listing_start</bpmn:outgoing>
      </bpmn:startEvent>
      
      <!-- Step 1: Get Industry Info First -->
      <bpmn:serviceTask id="Task_Listing_IndustryInfo" name="Query PG:&#10;Industry by Slug">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="industry_by_slug" />
            <zeebe:header key="fields" value="id,name,description,banner_image" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_listing_start</bpmn:incoming>
        <bpmn:outgoing>Flow_industry_to_parallel</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Parallel Gateway - Run remaining tasks together -->
      <bpmn:parallelGateway id="Gateway_Listing_Parallel_Start">
        <bpmn:incoming>Flow_industry_to_parallel</bpmn:incoming>
        <bpmn:outgoing>Flow_to_featured_categories</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_search_listings</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_recommended</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <!-- Task 2: Featured Categories -->
      <bpmn:serviceTask id="Task_Listing_FeaturedCategories" name="Query PG:&#10;Featured 8 Categories">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="categories_featured_8" />
            <zeebe:header key="industryId" value="${industryId}" />
            <zeebe:header key="limit" value="8" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_featured_categories</bpmn:incoming>
        <bpmn:outgoing>Flow_categories_done_listing</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 3: Search Listings with Filters -->
      <bpmn:serviceTask id="Task_Listing_Search" name="Query ES:&#10;Search with Filters">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-elasticsearch" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="ES_SEARCH_WITH_FILTERS" />
            <zeebe:header key="index" value="franchises" />
            <zeebe:header key="filters" value="${searchFilters}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_search_listings</bpmn:incoming>
        <bpmn:outgoing>Flow_search_done_listing</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 4: Recommended by Industry -->
      <bpmn:serviceTask id="Task_Listing_Recommended" name="Query ES:&#10;Recommended Franchises">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-elasticsearch" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="ES_RECOMMENDED_BY_INDUSTRY" />
            <zeebe:header key="industryId" value="${industryId}" />
            <zeebe:header key="limit" value="4" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_recommended</bpmn:incoming>
        <bpmn:outgoing>Flow_recommended_done_listing</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Parallel Gateway End -->
      <bpmn:parallelGateway id="Gateway_Listing_Parallel_End">
        <bpmn:incoming>Flow_categories_done_listing</bpmn:incoming>
        <bpmn:incoming>Flow_search_done_listing</bpmn:incoming>
        <bpmn:incoming>Flow_recommended_done_listing</bpmn:incoming>
        <bpmn:outgoing>Flow_listing_end</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <bpmn:endEvent id="Event_Listing_End">
        <bpmn:incoming>Flow_listing_end</bpmn:incoming>
      </bpmn:endEvent>
      
      <!-- Listing Page Internal Flows -->
      <bpmn:sequenceFlow id="Flow_listing_start" sourceRef="Event_Listing_Start" targetRef="Task_Listing_IndustryInfo" />
      <bpmn:sequenceFlow id="Flow_industry_to_parallel" sourceRef="Task_Listing_IndustryInfo" targetRef="Gateway_Listing_Parallel_Start" />
      <bpmn:sequenceFlow id="Flow_to_featured_categories" sourceRef="Gateway_Listing_Parallel_Start" targetRef="Task_Listing_FeaturedCategories" />
      <bpmn:sequenceFlow id="Flow_to_search_listings" sourceRef="Gateway_Listing_Parallel_Start" targetRef="Task_Listing_Search" />
      <bpmn:sequenceFlow id="Flow_to_recommended" sourceRef="Gateway_Listing_Parallel_Start" targetRef="Task_Listing_Recommended" />
      <bpmn:sequenceFlow id="Flow_categories_done_listing" sourceRef="Task_Listing_FeaturedCategories" targetRef="Gateway_Listing_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_search_done_listing" sourceRef="Task_Listing_Search" targetRef="Gateway_Listing_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_recommended_done_listing" sourceRef="Task_Listing_Recommended" targetRef="Gateway_Listing_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_listing_end" sourceRef="Gateway_Listing_Parallel_End" targetRef="Event_Listing_End" />
    </bpmn:subProcess>
    
    <!-- ========================================== -->
    <!-- DETAIL PAGE FLOW - All Parallel -->
    <!-- ========================================== -->
    <bpmn:subProcess id="SubProcess_DetailPage" name="DETAIL PAGE (Kathi Junction)">
      <bpmn:incoming>Flow_to_detail</bpmn:incoming>
      <bpmn:outgoing>Flow_detail_to_merge</bpmn:outgoing>
      
      <bpmn:startEvent id="Event_Detail_Start">
        <bpmn:outgoing>Flow_detail_start_parallel</bpmn:outgoing>
      </bpmn:startEvent>
      
      <!-- All 6 queries run in parallel -->
      <bpmn:parallelGateway id="Gateway_Detail_Parallel_Start">
        <bpmn:incoming>Flow_detail_start_parallel</bpmn:incoming>
        <bpmn:outgoing>Flow_to_franchise_basic</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_overview</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_business</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_investment</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_operations</bpmn:outgoing>
        <bpmn:outgoing>Flow_to_social</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <!-- Task 1: Basic Franchise Data (ES) -->
      <bpmn:serviceTask id="Task_Detail_FranchiseBasic" name="Query ES:&#10;Franchise by Slug">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-elasticsearch" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="ES_FRANCHISE_BY_SLUG" />
            <zeebe:header key="slug" value="${franchiseSlug}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_franchise_basic</bpmn:incoming>
        <bpmn:outgoing>Flow_basic_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 2: Overview (PG) -->
      <bpmn:serviceTask id="Task_Detail_Overview" name="Query PG:&#10;Franchise Overview">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="franchise_overview" />
            <zeebe:header key="franchiseId" value="${franchiseId}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_overview</bpmn:incoming>
        <bpmn:outgoing>Flow_overview_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 3: Business Details (PG) -->
      <bpmn:serviceTask id="Task_Detail_Business" name="Query PG:&#10;Business Overview">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="franchise_business" />
            <zeebe:header key="franchiseId" value="${franchiseId}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_business</bpmn:incoming>
        <bpmn:outgoing>Flow_business_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 4: Investment Requirements (PG) -->
      <bpmn:serviceTask id="Task_Detail_Investment" name="Query PG:&#10;Investment Req">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="franchise_investment" />
            <zeebe:header key="franchiseId" value="${franchiseId}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_investment</bpmn:incoming>
        <bpmn:outgoing>Flow_investment_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 5: Operations Info (PG) -->
      <bpmn:serviceTask id="Task_Detail_Operations" name="Query PG:&#10;Operations">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="franchise_operations" />
            <zeebe:header key="franchiseId" value="${franchiseId}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_operations</bpmn:incoming>
        <bpmn:outgoing>Flow_operations_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Task 6: Social Links (PG) -->
      <bpmn:serviceTask id="Task_Detail_Social" name="Query PG:&#10;Social Links">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-postgresql" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="queryType" value="franchise_social" />
            <zeebe:header key="franchiseId" value="${franchiseId}" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_to_social</bpmn:incoming>
        <bpmn:outgoing>Flow_social_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Parallel End - Wait for all 6 -->
      <bpmn:parallelGateway id="Gateway_Detail_Parallel_End">
        <bpmn:incoming>Flow_basic_done</bpmn:incoming>
        <bpmn:incoming>Flow_overview_done</bpmn:incoming>
        <bpmn:incoming>Flow_business_done</bpmn:incoming>
        <bpmn:incoming>Flow_investment_done</bpmn:incoming>
        <bpmn:incoming>Flow_operations_done</bpmn:incoming>
        <bpmn:incoming>Flow_social_done</bpmn:incoming>
        <bpmn:outgoing>Flow_detail_end</bpmn:outgoing>
      </bpmn:parallelGateway>
      
      <bpmn:endEvent id="Event_Detail_End">
        <bpmn:incoming>Flow_detail_end</bpmn:incoming>
      </bpmn:endEvent>
      
      <!-- Detail Page Internal Flows -->
      <bpmn:sequenceFlow id="Flow_detail_start_parallel" sourceRef="Event_Detail_Start" targetRef="Gateway_Detail_Parallel_Start" />
      <bpmn:sequenceFlow id="Flow_to_franchise_basic" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_FranchiseBasic" />
      <bpmn:sequenceFlow id="Flow_to_overview" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_Overview" />
      <bpmn:sequenceFlow id="Flow_to_business" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_Business" />
      <bpmn:sequenceFlow id="Flow_to_investment" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_Investment" />
      <bpmn:sequenceFlow id="Flow_to_operations" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_Operations" />
      <bpmn:sequenceFlow id="Flow_to_social" sourceRef="Gateway_Detail_Parallel_Start" targetRef="Task_Detail_Social" />
      <bpmn:sequenceFlow id="Flow_basic_done" sourceRef="Task_Detail_FranchiseBasic" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_overview_done" sourceRef="Task_Detail_Overview" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_business_done" sourceRef="Task_Detail_Business" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_investment_done" sourceRef="Task_Detail_Investment" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_operations_done" sourceRef="Task_Detail_Operations" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_social_done" sourceRef="Task_Detail_Social" targetRef="Gateway_Detail_Parallel_End" />
      <bpmn:sequenceFlow id="Flow_detail_end" sourceRef="Gateway_Detail_Parallel_End" targetRef="Event_Detail_End" />
    </bpmn:subProcess>
    
    <!-- ========================================== -->
    <!-- AI SEARCH FLOW - Sequential Pipeline with NLP -->
    <!-- ========================================== -->
    <bpmn:subProcess id="SubProcess_AISearch" name="AI SEARCH (LLM Pipeline)">
      <bpmn:incoming>Flow_to_ai_search</bpmn:incoming>
      <bpmn:outgoing>Flow_aisearch_to_merge</bpmn:outgoing>
      
      <bpmn:startEvent id="Event_AISearch_Start">
        <bpmn:outgoing>Flow_ai_start</bpmn:outgoing>
      </bpmn:startEvent>
      
      <!-- Step 1: AI Natural Language Processing -->
      <bpmn:serviceTask id="Task_AI_NLP" name="AI NLP&#10;Processing">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="ai-natural-language-processing" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="useLLM" value="true" />
            <zeebe:header key="model" value="gpt-4" />
            <zeebe:header key="extractEntities" value="true" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ai_start</bpmn:incoming>
        <bpmn:outgoing>Flow_nlp_to_intent</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Step 2: Parse User Intent -->
      <bpmn:serviceTask id="Task_AI_ParseIntent" name="Parse User&#10;Intent (LLM)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="parse-user-intent" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="useLLM" value="true" />
            <zeebe:header key="model" value="gpt-4" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_nlp_to_intent</bpmn:incoming>
        <bpmn:outgoing>Flow_intent_to_filters</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Step 3: Parse Search Filters -->
      <bpmn:serviceTask id="Task_AI_ParseFilters" name="Parse Search&#10;Filters">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="parse-search-filters" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="extractInvestment" value="true" />
            <zeebe:header key="extractLocation" value="true" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_intent_to_filters</bpmn:incoming>
        <bpmn:outgoing>Flow_filters_to_enrich</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Step 4: Enrich with Web Search -->
      <bpmn:serviceTask id="Task_AI_EnrichSearch" name="Enrich Web&#10;Search">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="enrich-web-search" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="searchEngine" value="google" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_filters_to_enrich</bpmn:incoming>
        <bpmn:outgoing>Flow_enrich_to_query</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Step 5: Query Internal Data -->
      <bpmn:serviceTask id="Task_AI_QueryInternal" name="Query Internal&#10;Franchise Data">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-internal-data" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="sources" value="elasticsearch,postgresql" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_enrich_to_query</bpmn:incoming>
        <bpmn:outgoing>Flow_query_to_synthesis</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <!-- Step 6: LLM Synthesis -->
      <bpmn:serviceTask id="Task_AI_LLMSynthesis" name="LLM Synthesis&#10;&amp; Ranking">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="llm-synthesis" retries="2" />
          <zeebe:taskHeaders>
            <zeebe:header key="model" value="gpt-4" />
            <zeebe:header key="temperature" value="0.7" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_query_to_synthesis</bpmn:incoming>
        <bpmn:outgoing>Flow_synthesis_done</bpmn:outgoing>
      </bpmn:serviceTask>
      
      <bpmn:endEvent id="Event_AISearch_End">
        <bpmn:incoming>Flow_synthesis_done</bpmn:incoming>
      </bpmn:endEvent>
      
      <!-- AI Search Internal Flows -->
      <bpmn:sequenceFlow id="Flow_ai_start" sourceRef="Event_AISearch_Start" targetRef="Task_AI_NLP" />
      <bpmn:sequenceFlow id="Flow_nlp_to_intent" sourceRef="Task_AI_NLP" targetRef="Task_AI_ParseIntent" />
      <bpmn:sequenceFlow id="Flow_intent_to_filters" sourceRef="Task_AI_ParseIntent" targetRef="Task_AI_ParseFilters" />
      <bpmn:sequenceFlow id="Flow_filters_to_enrich" sourceRef="Task_AI_ParseFilters" targetRef="Task_AI_EnrichSearch" />
      <bpmn:sequenceFlow id="Flow_enrich_to_query" sourceRef="Task_AI_EnrichSearch" targetRef="Task_AI_QueryInternal" />
      <bpmn:sequenceFlow id="Flow_query_to_synthesis" sourceRef="Task_AI_QueryInternal" targetRef="Task_AI_LLMSynthesis" />
      <bpmn:sequenceFlow id="Flow_synthesis_done" sourceRef="Task_AI_LLMSynthesis" targetRef="Event_AISearch_End" />
    </bpmn:subProcess>
    
    <!-- ========================================== -->
    <!-- MERGE ALL PATHS -->
    <!-- ========================================== -->
    <bpmn:exclusiveGateway id="Gateway_MergeAll" name="Merge Results">
      <bpmn:incoming>Flow_home_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_listing_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_detail_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_aisearch_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_error_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_to_build</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- BUILD RESPONSE -->
    <bpmn:serviceTask id="Task_BuildResponse" name="Build JSON&#10;Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-response" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="format" value="json" />
          <zeebe:header key="includeMetadata" value="true" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_merge_to_build</bpmn:incoming>
      <bpmn:incoming>Flow_timeout_error</bpmn:incoming>
      <bpmn:outgoing>Flow_build_to_send</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- SEND API RESPONSE -->
    <bpmn:serviceTask id="Task_SendResponse" name="Send API&#10;Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="contentType" value="application/json" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_build_to_send</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- TIMEOUT BOUNDARY EVENT -->
    <bpmn:boundaryEvent id="Event_Timeout" name="Timeout&#10;30s" attachedToRef="Task_SendResponse">
      <bpmn:outgoing>Flow_timeout_error</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    
    <!-- ERROR HANDLING TASK -->
    <bpmn:serviceTask id="Task_ErrorHandler" name="Handle&#10;Unknown Route">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-response" />
        <zeebe:taskHeaders>
          <zeebe:header key="error" value="true" />
          <zeebe:header key="errorCode" value="404" />
          <zeebe:header key="errorMessage" value="Unknown operation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_default_error</bpmn:incoming>
      <bpmn:outgoing>Flow_error_to_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- END EVENT -->
    <bpmn:endEvent id="Event_End" name="Response&#10;Sent">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- ========================================== -->
    <!-- MAIN SEQUENCE FLOWS -->
    <!-- ========================================== -->
    
    <bpmn:sequenceFlow id="Flow_start_to_router" sourceRef="StartEvent_1" targetRef="Gateway_MainRouter" />
    
    <!-- Router to SubProcesses -->
    <bpmn:sequenceFlow id="Flow_to_home" name="operation =&#10;&quot;home_page&quot;" sourceRef="Gateway_MainRouter" targetRef="SubProcess_HomePage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=operation = "home_page"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_to_listing" name="operation =&#10;&quot;listing_page&quot;" sourceRef="Gateway_MainRouter" targetRef="SubProcess_ListingPage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=operation = "listing_page"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_to_detail" name="operation =&#10;&quot;detail_page&quot;" sourceRef="Gateway_MainRouter" targetRef="SubProcess_DetailPage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=operation = "detail_page"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_to_ai_search" name="search&#10;operations" sourceRef="Gateway_MainRouter" targetRef="SubProcess_AISearch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=list contains(["search_franchises", "ai_search", "simple_search"], operation)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_default_error" name="else" sourceRef="Gateway_MainRouter" targetRef="Task_ErrorHandler" />
    
    <!-- SubProcesses to Merge -->
    <bpmn:sequenceFlow id="Flow_home_to_merge" sourceRef="SubProcess_HomePage" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_listing_to_merge" sourceRef="SubProcess_ListingPage" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_detail_to_merge" sourceRef="SubProcess_DetailPage" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_aisearch_to_merge" sourceRef="SubProcess_AISearch" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_error_to_merge" sourceRef="Task_ErrorHandler" targetRef="Gateway_MergeAll" />
    
    <!-- Response Chain -->
    <bpmn:sequenceFlow id="Flow_merge_to_build" sourceRef="Gateway_MergeAll" targetRef="Task_BuildResponse" />
    <bpmn:sequenceFlow id="Flow_build_to_send" sourceRef="Task_BuildResponse" targetRef="Task_SendResponse" />
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Task_SendResponse" targetRef="Event_End" />
    
    <!-- Error Flows -->
    <bpmn:sequenceFlow id="Flow_timeout_error" sourceRef="Event_Timeout" targetRef="Task_BuildResponse" />
    
  </bpmn:process>
  
  <!-- ========================================== -->
  <!-- BPMN DIAGRAM INTERCHANGE -->
  <!-- ========================================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="franchise-mvp-workflow">
      
