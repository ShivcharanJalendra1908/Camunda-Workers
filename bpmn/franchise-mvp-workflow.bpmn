      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_to_investment_di" bpmnElement="Flow_to_investment">
        <di:waypoint x="510" y="865" />
        <di:waypoint x="510" y="800" />
        <di:waypoint x="780" y="800" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_to_operations_di" bpmnElement="Flow_to_operations">
