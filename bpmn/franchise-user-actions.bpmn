<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <process id="franchise-user-actions" name="Franchise User Actions" isExecutable="true">
    <startEvent id="StartEvent_UserAction" name="User Action Request">
      <outgoing>Flow_ToAuthGateway</outgoing>
    </startEvent>
    <exclusiveGateway id="Gateway_AuthCheck" name="Auth Required?">
      <incoming>Flow_ToAuthGateway</incoming>
      <outgoing>Flow_ToValidateUser</outgoing>
      <outgoing>Flow_ToContactUs</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_ValidateSubscription" name="Validate User&#10;Subscription">
      <extensionElements>
        <zeebe:taskDefinition type="validate-subscription" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=&#34;free&#34;" target="subscriptionTier" />
          <zeebe:output source="=isValid" target="subscriptionValid" />
          <zeebe:output source="=tierLevel" target="tierLevel" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToValidateUser</incoming>
      <outgoing>Flow_ToActionGateway</outgoing>
    </serviceTask>
    <serviceTask id="Task_SaveContactMessage" name="Save Contact Message">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SAVE_CONTACT_MESSAGE&#34;" target="operation_type" />
          <zeebe:input source="=contactName" target="contactName" />
          <zeebe:input source="=contactEmail" target="contactEmail" />
          <zeebe:input source="=contactMessage" target="contactMessage" />
          <zeebe:input source="=contactCompany" target="contactCompany" />
          <zeebe:input source="=contactPhone" target="contactPhone" />
          <zeebe:input source="=ipAddress" target="ipAddress" />
          <zeebe:output source="=id" target="contactId" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToContactUs</incoming>
      <outgoing>Flow_Contact_To_EmailTeam</outgoing>
    </serviceTask>
    <serviceTask id="Task_EmailTeam" name="Notify Lemici Team">
      <extensionElements>
        <zeebe:taskDefinition type="email-send" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=teamEmail" target="to" />
          <zeebe:input source="=&#34;New Message from &#34; + contactName" target="subject" />
          <zeebe:input source="=&#34;Name: &#34; + contactName + &#34;\nEmail: &#34; + contactEmail + &#34;\nCompany: &#34; + contactCompany + &#34;\nPhone: &#34; + contactPhone + &#34;\n\nMessage:\n&#34; + contactMessage" target="body" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_Contact_To_EmailTeam</incoming>
      <outgoing>Flow_EmailTeam_To_EmailUser</outgoing>
    </serviceTask>
    <serviceTask id="Task_EmailUser" name="Auto-Reply to User">
      <extensionElements>
        <zeebe:taskDefinition type="email-send" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=contactEmail" target="to" />
          <zeebe:input source="=&#34;Thank you for contacting Lemici&#34;" target="subject" />
          <zeebe:input source="=&#34;Hi &#34; + contactName + &#34;,\n\nThank you for reaching out to us. We have received your message and our team will get back to you shortly.\n\nBest regards,\nTeam Lemici&#34;" target="body" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_EmailTeam_To_EmailUser</incoming>
      <outgoing>Flow_Contact_ToResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_ValidateSubscription" name="Subscription&#10;Error" attachedToRef="Task_ValidateSubscription">
      <outgoing>Flow_SubscriptionError_To_HandleError</outgoing>
      <errorEventDefinition id="ErrorDef_Subscription" errorRef="Error_SubscriptionFailed" />
    </boundaryEvent>
    <exclusiveGateway id="Gateway_ActionRouter" name="Which Action?">
      <incoming>Flow_ToActionGateway</incoming>
      <outgoing>Flow_ToBookmarkGateway</outgoing>
      <outgoing>Flow_ToRatingGateway</outgoing>
      <outgoing>Flow_ToShare</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_BookmarkType" name="Bookmark Op?">
      <incoming>Flow_ToBookmarkGateway</incoming>
      <outgoing>Flow_ToAddBookmark</outgoing>
      <outgoing>Flow_ToRemoveBookmark</outgoing>
      <outgoing>Flow_ToGetBookmarks</outgoing>
      <outgoing>Flow_ToCheckBookmark</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_AddBookmark" name="Add Bookmark">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;ADD_BOOKMARK&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:output source="=id" target="bookmarkId" />
          <zeebe:output source="=isBookmarked" target="isBookmarked" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToAddBookmark</incoming>
      <outgoing>Flow_AddBookmark_ToResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_AddBookmark" name="Bookmark&#10;Error" attachedToRef="Task_AddBookmark">
      <outgoing>Flow_BookmarkError_To_HandleError</outgoing>
      <errorEventDefinition id="ErrorDef_AddBookmark" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_RemoveBookmark" name="Remove Bookmark">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REMOVE_BOOKMARK&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToRemoveBookmark</incoming>
      <outgoing>Flow_RemoveBookmark_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_GetBookmarks" name="Get User Bookmarks">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;GET_USER_BOOKMARKS&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=page" target="page" />
          <zeebe:input source="=limit" target="limit" />
          <zeebe:output source="=bookmarks" target="bookmarks" />
          <zeebe:output source="=totalCount" target="totalCount" />
          <zeebe:output source="=success" target="success" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToGetBookmarks</incoming>
      <outgoing>Flow_GetBookmarks_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_CheckBookmark" name="Check Bookmark Status">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CHECK_BOOKMARK&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:output source="=isBookmarked" target="isBookmarked" />
          <zeebe:output source="=bookmarkId" target="bookmarkId" />
          <zeebe:output source="=success" target="success" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToCheckBookmark</incoming>
      <outgoing>Flow_CheckBookmark_ToResponse</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_RatingType" name="Rating Op?">
      <incoming>Flow_ToRatingGateway</incoming>
      <outgoing>Flow_ToSubmitRating</outgoing>
      <outgoing>Flow_ToUpdateRating</outgoing>
      <outgoing>Flow_ToGetUserRating</outgoing>
      <outgoing>Flow_ToGetFranchiseRatings</outgoing>
      <outgoing>Flow_ToDeleteRating</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_SubmitRating" name="Submit User Rating">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SUBMIT_USER_RATING&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:input source="=rating" target="rating" />
          <zeebe:input source="=review" target="review" />
          <zeebe:output source="=id" target="ratingId" />
          <zeebe:output source="=rating" target="submittedRating" />
          <zeebe:output source="=isNew" target="isNew" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToSubmitRating</incoming>
      <outgoing>Flow_SubmitRating_ToResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_SubmitRating" name="Rating&#10;Error" attachedToRef="Task_SubmitRating">
      <outgoing>Flow_RatingError_To_HandleError</outgoing>
      <errorEventDefinition id="ErrorDef_SubmitRating" errorRef="Error_ValidationError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdateRating" name="Update User Rating">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_USER_RATING&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:input source="=rating" target="rating" />
          <zeebe:input source="=review" target="review" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdateRating</incoming>
      <outgoing>Flow_UpdateRating_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_GetUserRating" name="Get User&#39;s Rating">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;GET_USER_RATING&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:output source="=hasRated" target="hasRated" />
          <zeebe:output source="=rating" target="userRating" />
          <zeebe:output source="=review" target="userReview" />
          <zeebe:output source="=success" target="success" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToGetUserRating</incoming>
      <outgoing>Flow_GetUserRating_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_GetFranchiseRatings" name="Get All Franchise Ratings">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;GET_FRANCHISE_RATINGS&#34;" target="operation_type" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:input source="=page" target="page" />
          <zeebe:input source="=limit" target="limit" />
          <zeebe:output source="=ratings" target="ratings" />
          <zeebe:output source="=totalCount" target="totalCount" />
          <zeebe:output source="=avgRating" target="avgRating" />
          <zeebe:output source="=success" target="success" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToGetFranchiseRatings</incoming>
      <outgoing>Flow_GetFranchiseRatings_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_DeleteRating" name="Delete User Rating">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;DELETE_USER_RATING&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToDeleteRating</incoming>
      <outgoing>Flow_DeleteRating_ToResponse</outgoing>
    </serviceTask>
    <serviceTask id="Task_ShareFranchise" name="Record Share Event">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SHARE_FRANCHISE&#34;" target="operation_type" />
          <zeebe:input source="=franchiseId" target="franchise_id" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=sharePlatform" target="sharePlatform" />
          <zeebe:input source="=ipAddress" target="ipAddress" />
          <zeebe:output source="=shareId" target="shareId" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToShare</incoming>
      <outgoing>Flow_Share_ToResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_Share" name="Share&#10;Error" attachedToRef="Task_ShareFranchise">
      <outgoing>Flow_ShareError_To_HandleError</outgoing>
      <errorEventDefinition id="ErrorDef_Share" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <exclusiveGateway id="Gateway_MergeBeforeResponse" name="Merge">
      <incoming>Flow_AddBookmark_ToResponse</incoming>
      <incoming>Flow_RemoveBookmark_ToResponse</incoming>
      <incoming>Flow_GetBookmarks_ToResponse</incoming>
      <incoming>Flow_CheckBookmark_ToResponse</incoming>
      <incoming>Flow_SubmitRating_ToResponse</incoming>
      <incoming>Flow_UpdateRating_ToResponse</incoming>
      <incoming>Flow_GetUserRating_ToResponse</incoming>
      <incoming>Flow_GetFranchiseRatings_ToResponse</incoming>
      <incoming>Flow_DeleteRating_ToResponse</incoming>
      <incoming>Flow_Share_ToResponse</incoming>
      <incoming>Flow_Contact_ToResponse</incoming>
      <outgoing>Flow_ToSendResponse</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_SendResponse" name="Send API Response">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: success, message: message, data: {contactId: contactId, bookmarkId: bookmarkId, isBookmarked: isBookmarked, bookmarks: bookmarks, ratingId: ratingId, rating: if submittedRating != null then submittedRating else userRating, userRating: userRating, userReview: userReview, hasRated: hasRated, ratings: ratings, avgRating: avgRating, shareId: shareId, totalCount: totalCount}}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToSendResponse</incoming>
      <outgoing>Flow_ToEnd</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_ErrorMerge" name="Error&#10;Merge">
      <incoming>Flow_SubscriptionError_To_HandleError</incoming>
      <incoming>Flow_RatingError_To_HandleError</incoming>
      <incoming>Flow_ShareError_To_HandleError</incoming>
      <incoming>Flow_ValidationError_To_HandleError</incoming>
      <incoming>Flow_BookmarkError_To_HandleError</incoming>
      <outgoing>Flow_ToHandleError</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_HandleError" name="Send Error Response">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: false, error: errorCode, message: errorMessage}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToHandleError</incoming>
      <outgoing>Flow_Error_ToEnd</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Success" name="Action&#10;Completed">
      <incoming>Flow_ToEnd</incoming>
    </endEvent>
    <endEvent id="EndEvent_Error" name="Action&#10;Failed">
      <incoming>Flow_Error_ToEnd</incoming>
      <errorEventDefinition id="ErrorDef_End" errorRef="Error_ActionFailed" />
    </endEvent>
    <sequenceFlow id="Flow_ToAuthGateway" sourceRef="StartEvent_UserAction" targetRef="Gateway_AuthCheck" />
    <sequenceFlow id="Flow_ToContactUs" name="Contact Us" sourceRef="Gateway_AuthCheck" targetRef="Task_SaveContactMessage">
      <conditionExpression xsi:type="tFormalExpression">=action = "contact_us"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToValidateUser" name="Auth Required" sourceRef="Gateway_AuthCheck" targetRef="Task_ValidateSubscription">
      <conditionExpression xsi:type="tFormalExpression">=action != "contact_us"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Contact_To_EmailTeam" sourceRef="Task_SaveContactMessage" targetRef="Task_EmailTeam" />
    <sequenceFlow id="Flow_EmailTeam_To_EmailUser" sourceRef="Task_EmailTeam" targetRef="Task_EmailUser" />
    <sequenceFlow id="Flow_Contact_ToResponse" sourceRef="Task_EmailUser" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_ToActionGateway" sourceRef="Task_ValidateSubscription" targetRef="Gateway_ActionRouter" />
    <sequenceFlow id="Flow_ToBookmarkGateway" sourceRef="Gateway_ActionRouter" targetRef="Gateway_BookmarkType">
      <conditionExpression xsi:type="tFormalExpression">
        =action = "add_bookmark" or action = "remove_bookmark" or action = "get_bookmarks" or action = "check_bookmark"
      </conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToRatingGateway" sourceRef="Gateway_ActionRouter" targetRef="Gateway_RatingType">
      <conditionExpression xsi:type="tFormalExpression">
        =action = "submit_rating" or action = "update_rating" or action = "get_user_rating" or action = "get_franchise_ratings" or action = "delete_rating"
      </conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToShare" sourceRef="Gateway_ActionRouter" targetRef="Task_ShareFranchise">
      <conditionExpression xsi:type="tFormalExpression">
        =action = "share_franchise"
      </conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToAddBookmark" sourceRef="Gateway_BookmarkType" targetRef="Task_AddBookmark">
      <conditionExpression xsi:type="tFormalExpression">=action = "add_bookmark"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToRemoveBookmark" sourceRef="Gateway_BookmarkType" targetRef="Task_RemoveBookmark">
      <conditionExpression xsi:type="tFormalExpression">=action = "remove_bookmark"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToGetBookmarks" sourceRef="Gateway_BookmarkType" targetRef="Task_GetBookmarks">
      <conditionExpression xsi:type="tFormalExpression">=action = "get_bookmarks"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToCheckBookmark" sourceRef="Gateway_BookmarkType" targetRef="Task_CheckBookmark">
      <conditionExpression xsi:type="tFormalExpression">=action = "check_bookmark"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToSubmitRating" sourceRef="Gateway_RatingType" targetRef="Task_SubmitRating">
      <conditionExpression xsi:type="tFormalExpression">=action = "submit_rating"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdateRating" sourceRef="Gateway_RatingType" targetRef="Task_UpdateRating">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_rating"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToGetUserRating" sourceRef="Gateway_RatingType" targetRef="Task_GetUserRating">
      <conditionExpression xsi:type="tFormalExpression">=action = "get_user_rating"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToGetFranchiseRatings" sourceRef="Gateway_RatingType" targetRef="Task_GetFranchiseRatings">
      <conditionExpression xsi:type="tFormalExpression">=action = "get_franchise_ratings"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToDeleteRating" sourceRef="Gateway_RatingType" targetRef="Task_DeleteRating">
      <conditionExpression xsi:type="tFormalExpression">=action = "delete_rating"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_AddBookmark_ToResponse" sourceRef="Task_AddBookmark" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_RemoveBookmark_ToResponse" sourceRef="Task_RemoveBookmark" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_GetBookmarks_ToResponse" sourceRef="Task_GetBookmarks" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_CheckBookmark_ToResponse" sourceRef="Task_CheckBookmark" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_SubmitRating_ToResponse" sourceRef="Task_SubmitRating" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_UpdateRating_ToResponse" sourceRef="Task_UpdateRating" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_GetUserRating_ToResponse" sourceRef="Task_GetUserRating" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_GetFranchiseRatings_ToResponse" sourceRef="Task_GetFranchiseRatings" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_DeleteRating_ToResponse" sourceRef="Task_DeleteRating" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_Share_ToResponse" sourceRef="Task_ShareFranchise" targetRef="Gateway_MergeBeforeResponse" />
    <sequenceFlow id="Flow_ToSendResponse" sourceRef="Gateway_MergeBeforeResponse" targetRef="Task_SendResponse" />
    <sequenceFlow id="Flow_ToEnd" sourceRef="Task_SendResponse" targetRef="EndEvent_Success" />
    <sequenceFlow id="Flow_SubscriptionError_To_HandleError" sourceRef="BoundaryError_ValidateSubscription" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_BookmarkError_To_HandleError" sourceRef="BoundaryError_AddBookmark" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_RatingError_To_HandleError" sourceRef="BoundaryError_SubmitRating" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ShareError_To_HandleError" sourceRef="BoundaryError_Share" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ValidationError_To_HandleError" sourceRef="Gateway_ErrorMerge" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ToHandleError" sourceRef="Gateway_ErrorMerge" targetRef="Task_HandleError" />
    <sequenceFlow id="Flow_Error_ToEnd" sourceRef="Task_HandleError" targetRef="EndEvent_Error" />
  </process>
  <error id="Error_SubscriptionFailed" name="Subscription Failed" errorCode="SUBSCRIPTION_INVALID" />
  <error id="Error_DatabaseError" name="Database Error" errorCode="DATABASE_ERROR" />
  <error id="Error_ValidationError" name="Validation Error" errorCode="VALIDATION_ERROR" />
  <error id="Error_ActionFailed" name="Action Failed" errorCode="ACTION_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="franchise-user-actions">
      <bpmndi:BPMNShape id="Shape_Gateway_ActionRouter" bpmnElement="Gateway_ActionRouter" isMarkerVisible="true">
        <dc:Bounds x="515" y="445" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="463" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_BookmarkType" bpmnElement="Gateway_BookmarkType" isMarkerVisible="true">
