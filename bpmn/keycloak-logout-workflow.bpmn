<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Logout" 
                  targetNamespace="http://bpmn.io/schema/bpmn" 
                  exporter="Camunda Modeler" 
                  exporterVersion="5.14.0" 
                  modeler:executionPlatform="Camunda Cloud" 
                  modeler:executionPlatformVersion="8.2.0">
  
  <bpmn:process id="keycloak-logout-workflow" name="Keycloak Logout Workflow" isExecutable="true">
    
    <!-- START EVENT -->
    <bpmn:startEvent id="StartEvent_LogoutInitiated" name="User Clicks Logout">
      <bpmn:outgoing>Flow_ToGetSession</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- TASK 1: Get Session from Cookie -->
    <bpmn:serviceTask id="Task_GetSession" name="Get Session">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="session-manager" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;get&#34;" target="action" />
          <zeebe:input source="=sessionId" target="sessionId" />
          <zeebe:input source="=userId" target="userId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGetSession</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckSession</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- GATEWAY: Session Valid? -->
    <bpmn:exclusiveGateway id="Gateway_SessionValid" name="Session Valid?" default="Flow_SessionInvalid">
      <bpmn:incoming>Flow_ToCheckSession</bpmn:incoming>
      <bpmn:outgoing>Flow_SessionValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_SessionInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- TASK 2: Revoke Keycloak Session -->
    <bpmn:serviceTask id="Task_RevokeKeycloakSession" name="Revoke Keycloak Session">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auth.logout" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=sessionId" target="sessionId" />
          <zeebe:input source="=true" target="logoutAll" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SessionValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDeleteSession</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- TASK 3: Delete Session from Redis -->
    <bpmn:serviceTask id="Task_DeleteSession" name="Delete Session">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="session-manager" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;delete&#34;" target="action" />
          <zeebe:input source="=sessionId" target="sessionId" />
          <zeebe:input source="=userId" target="userId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDeleteSession</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClearCookie</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- MERGE GATEWAY -->
    <bpmn:exclusiveGateway id="Gateway_MergeLogout" name="Merge Flows">
      <bpmn:incoming>Flow_ToClearCookie</bpmn:incoming>
      <bpmn:incoming>Flow_SessionInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBuildResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- TASK 4: Build Logout Response -->
    <bpmn:serviceTask id="Task_BuildLogoutResponse" name="Build Logout Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="infrastructure.build-response" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;logged_out&#34;" target="status" />
          <zeebe:input source="=&#34;/login&#34;" target="redirectUrl" />
          <zeebe:input source="=cookieHeader" target="cookieHeader" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBuildResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- END EVENT -->
    <bpmn:endEvent id="EndEvent_LogoutSuccess" name="Logout Success (302 /login)">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_ToGetSession" sourceRef="StartEvent_LogoutInitiated" targetRef="Task_GetSession" />
    <bpmn:sequenceFlow id="Flow_ToCheckSession" sourceRef="Task_GetSession" targetRef="Gateway_SessionValid" />
    
    <bpmn:sequenceFlow id="Flow_SessionValid" name="Yes" sourceRef="Gateway_SessionValid" targetRef="Task_RevokeKeycloakSession">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=sessionSuccess = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_SessionInvalid" name="No / Skip" sourceRef="Gateway_SessionValid" targetRef="Gateway_MergeLogout" />
    
    <bpmn:sequenceFlow id="Flow_ToDeleteSession" sourceRef="Task_RevokeKeycloakSession" targetRef="Task_DeleteSession" />
    <bpmn:sequenceFlow id="Flow_ToClearCookie" sourceRef="Task_DeleteSession" targetRef="Gateway_MergeLogout" />
    <bpmn:sequenceFlow id="Flow_ToBuildResponse" sourceRef="Gateway_MergeLogout" targetRef="Task_BuildLogoutResponse" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_BuildLogoutResponse" targetRef="EndEvent_LogoutSuccess" />
    
  </bpmn:process>
  
  <!-- DIAGRAM (Visual Layout) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Logout">
    <bpmndi:BPMNPlane id="BPMNPlane_Logout" bpmnElement="keycloak-logout-workflow">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_LogoutInitiated_di" bpmnElement="StartEvent_LogoutInitiated">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="145" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Task 1 -->
      <bpmndi:BPMNShape id="Task_GetSession_di" bpmnElement="Task_GetSession">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Gateway: Session Valid -->
      <bpmndi:BPMNShape id="Gateway_SessionValid_di" bpmnElement="Gateway_SessionValid" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="65" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Task 2 -->
      <bpmndi:BPMNShape id="Task_RevokeKeycloakSession_di" bpmnElement="Task_RevokeKeycloakSession">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Task 3 -->
      <bpmndi:BPMNShape id="Task_DeleteSession_di" bpmnElement="Task_DeleteSession">
        <dc:Bounds x="660" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- Merge Gateway -->
      <bpmndi:BPMNShape id="Gateway_MergeLogout_di" bpmnElement="Gateway_MergeLogout" isMarkerVisible="true">
        <dc:Bounds x="815" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      
      <!-- Task 4 -->
      <bpmndi:BPMNShape id="Task_BuildLogoutResponse_di" bpmnElement="Task_BuildLogoutResponse">
        <dc:Bounds x="920" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_LogoutSuccess_di" bpmnElement="EndEvent_LogoutSuccess">
        <dc:Bounds x="1072" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1048" y="145" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- EDGES -->
      <bpmndi:BPMNEdge id="Flow_ToGetSession_di" bpmnElement="Flow_ToGetSession">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToCheckSession_di" bpmnElement="Flow_ToCheckSession">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SessionValid_di" bpmnElement="Flow_SessionValid">
        <di:waypoint x="445" y="120" />
        <di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="462" y="102" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_SessionInvalid_di" bpmnElement="Flow_SessionInvalid">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="420" y="230" />
        <di:waypoint x="840" y="230" />
        <di:waypoint x="840" y="145" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="163" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToDeleteSession_di" bpmnElement="Flow_ToDeleteSession">
        <di:waypoint x="600" y="120" />
        <di:waypoint x="660" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToClearCookie_di" bpmnElement="Flow_ToClearCookie">
        <di:waypoint x="760" y="120" />
        <di:waypoint x="815" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToBuildResponse_di" bpmnElement="Flow_ToBuildResponse">
        <di:waypoint x="865" y="120" />
        <di:waypoint x="920" y="120" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="1020" y="120" />
        <di:waypoint x="1072" y="120" />
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn:definitions>