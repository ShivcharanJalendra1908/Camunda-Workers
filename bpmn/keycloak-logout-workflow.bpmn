<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Logout" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <bpmn:process id="LogoutWorkflow" name="Keycloak Logout Workflow" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag v="1.1.0" />
    </bpmn:extensionElements>
    
    <bpmn:startEvent id="StartEvent_LogoutRequest" name="Logout Initiated">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:serviceTask id="Task_KeycloakRevoke" name="Keycloak Session Revoke">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auth-logout" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=keycloakUserId" target="keycloakUserId" />
          <zeebe:input source="=userId" target="userId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Split</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_RedisCleanup" name="Redis Session Cleanup">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="session-manager" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=sessionId" target="sessionId" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=&quot;delete&quot;" target="action" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_LogoutCompleted" name="Logout Background Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_LogoutRequest" targetRef="Task_KeycloakRevoke" />
    <bpmn:sequenceFlow id="Flow_Split" sourceRef="Task_KeycloakRevoke" targetRef="Task_RedisCleanup" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RedisCleanup" targetRef="EndEvent_LogoutCompleted" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LogoutWorkflow">
      <bpmndi:BPMNShape id="StartEvent_LogoutRequest_di" bpmnElement="StartEvent_LogoutRequest">
        <dc:Bounds x="150" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="143" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KeycloakRevoke_di" bpmnElement="Task_KeycloakRevoke">
        <dc:Bounds x="240" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RedisCleanup_di" bpmnElement="Task_RedisCleanup">
        <dc:Bounds x="400" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LogoutCompleted_di" bpmnElement="EndEvent_LogoutCompleted">
        <dc:Bounds x="560" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="533" y="143" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="186" y="118" />
        <di:waypoint x="240" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_di" bpmnElement="Flow_Split">
        <di:waypoint x="340" y="118" />
        <di:waypoint x="400" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="118" />
        <di:waypoint x="560" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
