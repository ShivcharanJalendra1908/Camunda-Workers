<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <process id="photo-upload" name="Photo Upload v1.0" isExecutable="true">
    <startEvent id="StartEvent_PhotoUpload" name="S3 Upload&#10;Complete">
      <outgoing>Flow_Start_To_ValidateOwnership</outgoing>
    </startEvent>
    <serviceTask id="Task_ValidateOwnership" name="Validate Ownership&#10;and Entity Exists">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=entityId" target="entityId" />
          <zeebe:input source="=entityType" target="entityType" />
          <zeebe:input source="=requestId" target="requestId" />
          <zeebe:input source="=&#34;VALIDATE_PHOTO_OWNERSHIP&#34;" target="operation_type" />
          <zeebe:output source="=ownershipValid" target="ownershipValid" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_Start_To_ValidateOwnership</incoming>
      <outgoing>Flow_ValidateOwnership_To_OwnershipGateway</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_ValidateOwnership" attachedToRef="Task_ValidateOwnership">
      <outgoing>Flow_BoundaryOwnership_To_ErrorMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Boundary_Ownership" errorRef="Error_ActionFailed" />
    </boundaryEvent>
    <exclusiveGateway id="Gateway_OwnershipValid" name="Ownership&#10;Valid?" default="Flow_OwnershipInvalid_To_ErrorMerge">
      <incoming>Flow_ValidateOwnership_To_OwnershipGateway</incoming>
      <outgoing>Flow_OwnershipValid_To_EntityRouter</outgoing>
      <outgoing>Flow_OwnershipInvalid_To_ErrorMerge</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_EntityRouter" name="Route by&#10;Entity Type" default="Flow_ToUnsupportedEntity">
      <incoming>Flow_OwnershipValid_To_EntityRouter</incoming>
      <outgoing>Flow_ToProfilePhoto</outgoing>
      <outgoing>Flow_ToFranchisePhoto</outgoing>
      <outgoing>Flow_ToListingPhoto</outgoing>
      <outgoing>Flow_ToUnsupportedEntity</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_PersistProfilePhoto" name="Persist Profile&#10;Photo Key">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=s3Key" target="s3Key" />
          <zeebe:input source="=&#34;PERSIST_PROFILE_PHOTO&#34;" target="operation_type" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToProfilePhoto</incoming>
      <outgoing>Flow_ProfilePhoto_To_PersistMerge</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_PersistProfilePhoto" attachedToRef="Task_PersistProfilePhoto">
      <outgoing>Flow_BoundaryPersistProfile_To_ErrorMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Boundary_PersistProfile" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_PersistFranchisePhoto" name="Persist Franchise&#10;Photo Key">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=entityId" target="entityId" />
          <zeebe:input source="=s3Key" target="s3Key" />
          <zeebe:input source="=&#34;PERSIST_FRANCHISE_PHOTO&#34;" target="operation_type" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToFranchisePhoto</incoming>
      <outgoing>Flow_FranchisePhoto_To_PersistMerge</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_PersistFranchisePhoto" attachedToRef="Task_PersistFranchisePhoto">
      <outgoing>Flow_BoundaryPersistFranchise_To_ErrorMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Boundary_PersistFranchise" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_PersistListingPhoto" name="Persist Listing&#10;Photo Key">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=entityId" target="entityId" />
          <zeebe:input source="=s3Key" target="s3Key" />
          <zeebe:input source="=&#34;PERSIST_LISTING_PHOTO&#34;" target="operation_type" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToListingPhoto</incoming>
      <outgoing>Flow_ListingPhoto_To_PersistMerge</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_PersistListingPhoto" attachedToRef="Task_PersistListingPhoto">
      <outgoing>Flow_BoundaryPersistListing_To_ErrorMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Boundary_PersistListing" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UnsupportedEntity" name="Unsupported&#10;Entity Type">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=entityType" target="entityType" />
          <zeebe:input source="=&#34;UNSUPPORTED_ENTITY&#34;" target="operation_type" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUnsupportedEntity</incoming>
      <outgoing>Flow_UnsupportedEntity_To_ErrorMerge</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_PersistMerge" name="Persist&#10;Merge">
      <incoming>Flow_ProfilePhoto_To_PersistMerge</incoming>
      <incoming>Flow_FranchisePhoto_To_PersistMerge</incoming>
      <incoming>Flow_ListingPhoto_To_PersistMerge</incoming>
      <outgoing>Flow_PersistMerge_To_AuditLog</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_WriteAuditLog" name="Write Photo&#10;Audit Log">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=entityType" target="entityType" />
          <zeebe:input source="=entityId" target="entityId" />
          <zeebe:input source="=s3Key" target="s3Key" />
          <zeebe:input source="=oldS3Key" target="oldS3Key" />
          <zeebe:input source="=requestId" target="requestId" />
          <zeebe:input source="=&#34;INSERT_PHOTO_AUDIT&#34;" target="operation_type" />
          <zeebe:output source="=auditId" target="auditId" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_PersistMerge_To_AuditLog</incoming>
      <outgoing>Flow_AuditLog_To_SendResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_AuditLog" attachedToRef="Task_WriteAuditLog">
      <outgoing>Flow_BoundaryAudit_To_ErrorMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Boundary_Audit" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_SendResponse" name="Send Success&#10;Response">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: true, s3Key: s3Key, auditId: auditId, entityType: entityType}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_AuditLog_To_SendResponse</incoming>
      <outgoing>Flow_SendResponse_To_SuccessEnd</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Success" name="Photo Key&#10;Persisted">
      <incoming>Flow_SendResponse_To_SuccessEnd</incoming>
    </endEvent>
    <exclusiveGateway id="Gateway_ErrorMerge" name="Error Merge">
      <incoming>Flow_BoundaryOwnership_To_ErrorMerge</incoming>
      <incoming>Flow_OwnershipInvalid_To_ErrorMerge</incoming>
      <incoming>Flow_BoundaryPersistProfile_To_ErrorMerge</incoming>
      <incoming>Flow_BoundaryPersistFranchise_To_ErrorMerge</incoming>
      <incoming>Flow_BoundaryPersistListing_To_ErrorMerge</incoming>
      <incoming>Flow_UnsupportedEntity_To_ErrorMerge</incoming>
      <incoming>Flow_BoundaryAudit_To_ErrorMerge</incoming>
      <outgoing>Flow_ErrorMerge_To_HandleError</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_HandleError" name="Handle Error">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: false, error: if errorCode != null then errorCode else &#34;INTERNAL_ERROR&#34;, message: if errorMessage != null then errorMessage else &#34;An unexpected error occurred&#34;}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ErrorMerge_To_HandleError</incoming>
      <outgoing>Flow_HandleError_To_ErrorEnd</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Error" name="Photo Upload&#10;Failed">
      <incoming>Flow_HandleError_To_ErrorEnd</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Start_To_ValidateOwnership" sourceRef="StartEvent_PhotoUpload" targetRef="Task_ValidateOwnership" />
    <sequenceFlow id="Flow_ValidateOwnership_To_OwnershipGateway" sourceRef="Task_ValidateOwnership" targetRef="Gateway_OwnershipValid" />
    <sequenceFlow id="Flow_OwnershipValid_To_EntityRouter" sourceRef="Gateway_OwnershipValid" targetRef="Gateway_EntityRouter">
      <conditionExpression xsi:type="tFormalExpression">=ownershipValid = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_OwnershipInvalid_To_ErrorMerge" sourceRef="Gateway_OwnershipValid" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ToProfilePhoto" sourceRef="Gateway_EntityRouter" targetRef="Task_PersistProfilePhoto">
      <conditionExpression xsi:type="tFormalExpression">=entityType = "profile"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToFranchisePhoto" sourceRef="Gateway_EntityRouter" targetRef="Task_PersistFranchisePhoto">
      <conditionExpression xsi:type="tFormalExpression">=entityType = "franchise"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToListingPhoto" sourceRef="Gateway_EntityRouter" targetRef="Task_PersistListingPhoto">
      <conditionExpression xsi:type="tFormalExpression">=entityType = "listing"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUnsupportedEntity" sourceRef="Gateway_EntityRouter" targetRef="Task_UnsupportedEntity" />
    <sequenceFlow id="Flow_ProfilePhoto_To_PersistMerge" sourceRef="Task_PersistProfilePhoto" targetRef="Gateway_PersistMerge" />
    <sequenceFlow id="Flow_FranchisePhoto_To_PersistMerge" sourceRef="Task_PersistFranchisePhoto" targetRef="Gateway_PersistMerge" />
    <sequenceFlow id="Flow_ListingPhoto_To_PersistMerge" sourceRef="Task_PersistListingPhoto" targetRef="Gateway_PersistMerge" />
    <sequenceFlow id="Flow_UnsupportedEntity_To_ErrorMerge" sourceRef="Task_UnsupportedEntity" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_PersistMerge_To_AuditLog" sourceRef="Gateway_PersistMerge" targetRef="Task_WriteAuditLog" />
    <sequenceFlow id="Flow_AuditLog_To_SendResponse" sourceRef="Task_WriteAuditLog" targetRef="Task_SendResponse" />
    <sequenceFlow id="Flow_SendResponse_To_SuccessEnd" sourceRef="Task_SendResponse" targetRef="EndEvent_Success" />
    <sequenceFlow id="Flow_BoundaryOwnership_To_ErrorMerge" sourceRef="BoundaryError_ValidateOwnership" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_BoundaryPersistProfile_To_ErrorMerge" sourceRef="BoundaryError_PersistProfilePhoto" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_BoundaryPersistFranchise_To_ErrorMerge" sourceRef="BoundaryError_PersistFranchisePhoto" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_BoundaryPersistListing_To_ErrorMerge" sourceRef="BoundaryError_PersistListingPhoto" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_BoundaryAudit_To_ErrorMerge" sourceRef="BoundaryError_AuditLog" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ErrorMerge_To_HandleError" sourceRef="Gateway_ErrorMerge" targetRef="Task_HandleError" />
    <sequenceFlow id="Flow_HandleError_To_ErrorEnd" sourceRef="Task_HandleError" targetRef="EndEvent_Error" />
  </process>
  <error id="Error_ValidationError" name="Validation Error" errorCode="VALIDATION_FAILED" />
  <error id="Error_DatabaseError" name="Database Error" errorCode="DATABASE_ERROR" />
  <error id="Error_ActionFailed" name="Action Failed" errorCode="ACTION_FAILED" />
