<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:process id="franchise-complete-registration" name="Franchise Complete Registration" isExecutable="true">
    
    <bpmn:startEvent id="StartEvent_1" name="Start Registration">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Step 1: Create Main Franchise Record -->
    <bpmn:serviceTask id="CreateFranchise" name="Create Franchise">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_FRANCHISE&#34;" target="operation_type" />
          <zeebe:input source="=name" target="name" />
          <zeebe:input source="=slug" target="slug" />
          <zeebe:input source="=founded_year" target="founded_year" />
          <zeebe:input source="=trusted_seller" target="trusted_seller" />
          <zeebe:input source="=total_outlets" target="total_outlets" />
          <zeebe:input source="=industry" target="industry" />
          <zeebe:input source="=description" target="description" />
          <zeebe:input source="=contact_email" target="contact_email" />
          <zeebe:input source="=user_id" target="created_by" />
          <zeebe:output source="=franchise_id" target="franchise_id" />
          <zeebe:output source="=success" target="franchise_created" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 2: Create Business Overview -->
    <bpmn:serviceTask id="CreateBusinessOverview" name="Create Business Overview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_BUSINESS_OVERVIEW&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=products" target="products" />
          <zeebe:input source="=services" target="services" />
          <zeebe:input source="=user_id" target="created_by" />
          <zeebe:output source="=success" target="business_overview_created" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 3: Create Investment Requirements -->
    <bpmn:serviceTask id="CreateInvestment" name="Create Investment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_INVESTMENT&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=initial_investment_min" target="initial_investment_min" />
          <zeebe:input source="=initial_investment_max" target="initial_investment_max" />
          <zeebe:input source="=franchise_fee" target="franchise_fee" />
          <zeebe:input source="=royalty_percentage" target="royalty_percentage" />
          <zeebe:input source="=user_id" target="created_by" />
          <zeebe:output source="=success" target="investment_created" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Step 4: Create Operations Info -->
    <bpmn:serviceTask id="CreateOperations" name="Create Operations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CREATE_OPERATIONS&#34;" target="operation_type" />
          <zeebe:input source="=franchise_id" target="franchise_id" />
          <zeebe:input source="=space_min_sqft" target="space_min_sqft" />
          <zeebe:input source="=space_max_sqft" target="space_max_sqft" />
          <zeebe:input source="=training_provided" target="training_provided" />
          <zeebe:input source="=training_details" target="training_details" />
          <zeebe:input source="=user_id" target="created_by" />
          <zeebe:output source="=success" target="operations_created" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Registration Complete">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="CreateFranchise" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CreateFranchise" targetRef="CreateBusinessOverview" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CreateBusinessOverview" targetRef="CreateInvestment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="CreateInvestment" targetRef="CreateOperations" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="CreateOperations" targetRef="EndEvent_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="franchise-complete-registration">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateFranchise_di" bpmnElement="CreateFranchise">
        <dc:Bounds x="270" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateBusinessOverview_di" bpmnElement="CreateBusinessOverview">
        <dc:Bounds x="430" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateInvestment_di" bpmnElement="CreateInvestment">
        <dc:Bounds x="590" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateOperations_di" bpmnElement="CreateOperations">
        <dc:Bounds x="750" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="912" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <dc:Point x="215" y="117" />
        <dc:Point x="270" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <dc:Point x="370" y="117" />
        <dc:Point x="430" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <dc:Point x="530" y="117" />
        <dc:Point x="590" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <dc:Point x="690" y="117" />
        <dc:Point x="750" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <dc:Point x="850" y="117" />
        <dc:Point x="912" y="117" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
