<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_blog_listing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="blog-listing-page" name="Blog Listing Page" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Blog Listing Page Request">
      <bpmn:outgoing>Flow_Start_To_Fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Fork" sourceRef="StartEvent_1" targetRef="Gateway_Fork" />
    <bpmn:parallelGateway id="Gateway_Fork" name="Fetch Data in Parallel">
      <bpmn:incoming>Flow_Start_To_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Listing</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Popular</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_GetListing" name="Get Blog Listing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-elasticsearch" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;blogs&#34;" target="indexName" />
          <zeebe:input source="=if categoryId != null and categoryId != &#34;&#34; then {&#34;query&#34;: {&#34;bool&#34;: {&#34;must&#34;: [{&#34;term&#34;: {&#34;category_id.keyword&#34;: categoryId}}]}}} else {&#34;query&#34;: {&#34;match_all&#34;: {}}}" target="query" />
          <zeebe:input source="=if page != null then page else 1" target="page" />
          <zeebe:input source="=if pageSize != null then pageSize else 10" target="pageSize" />
          <zeebe:output source="=data" target="blogListing" />
          <zeebe:output source="=total" target="totalCount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Listing</bpmn:incoming>
      <bpmn:outgoing>Flow_Listing_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GetPopular" name="Get Popular Blogs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-postgresql" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;BLOG_POPULAR&#34;" target="queryType" />
          <zeebe:input source="=4" target="limit" />
          <zeebe:output source="=data" target="popularBlogs" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Popular</bpmn:incoming>
      <bpmn:outgoing>Flow_Popular_To_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_To_Listing" sourceRef="Gateway_Fork" targetRef="Task_GetListing" />
    <bpmn:sequenceFlow id="Flow_To_Popular" sourceRef="Gateway_Fork" targetRef="Task_GetPopular" />
    <bpmn:parallelGateway id="Gateway_Join" name="Join Results">
      <bpmn:incoming>Flow_Listing_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Popular_To_Join</bpmn:incoming>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Listing_To_Join" sourceRef="Task_GetListing" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Popular_To_Join" sourceRef="Task_GetPopular" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_To_Build" sourceRef="Gateway_Join" targetRef="Task_BuildResponse" />
    <bpmn:sequenceFlow id="Flow_Build_To_Response" sourceRef="Task_BuildResponse" targetRef="Task_SendResponse" />
    <bpmn:serviceTask id="Task_BuildResponse" name="Build Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-response" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="=&#34;listing&#34;" target="pageType" />
          <zeebe:input source="=&#34;blog&#34;" target="entityType" />
          <zeebe:input source="={&#34;listing&#34;: blogListing, &#34;popular&#34;: popularBlogs}" target="data" />
          <zeebe:output source="=response" target="finalResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_To_Build</bpmn:incoming>
      <bpmn:outgoing>Flow_Build_To_Response</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendResponse" name="Send API Response">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-api-response" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="=finalResponse" target="response" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Build_To_Response</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_SendResponse" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="blog-listing-page">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="162" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="235" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="255" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="314.5" y="196" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetListing_di" bpmnElement="Task_GetListing">
        <dc:Bounds x="320" y="90" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetPopular_di" bpmnElement="Task_GetPopular">
        <dc:Bounds x="320" y="250" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="475" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="407" y="203" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildResponse_di" bpmnElement="Task_BuildResponse">
        <dc:Bounds x="570" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendResponse_di" bpmnElement="Task_SendResponse">
        <dc:Bounds x="715" y="170" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="892" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="901" y="235" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Fork_di" bpmnElement="Flow_Start_To_Fork">
        <di:waypoint x="198" y="210" />
        <di:waypoint x="255" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Listing_di" bpmnElement="Flow_To_Listing">
        <di:waypoint x="280" y="185" />
        <di:waypoint x="280" y="130" />
        <di:waypoint x="320" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Popular_di" bpmnElement="Flow_To_Popular">
        <di:waypoint x="280" y="235" />
        <di:waypoint x="280" y="290" />
        <di:waypoint x="320" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Listing_To_Join_di" bpmnElement="Flow_Listing_To_Join">
        <di:waypoint x="460" y="130" />
        <di:waypoint x="500" y="130" />
        <di:waypoint x="500" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Popular_To_Join_di" bpmnElement="Flow_Popular_To_Join">
        <di:waypoint x="460" y="290" />
        <di:waypoint x="500" y="290" />
        <di:waypoint x="500" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_To_Build_di" bpmnElement="Flow_Join_To_Build">
        <di:waypoint x="525" y="210" />
        <di:waypoint x="570" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Build_To_Response_di" bpmnElement="Flow_Build_To_Response">
        <di:waypoint x="670" y="210" />
        <di:waypoint x="715" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End_di" bpmnElement="Flow_End">
        <di:waypoint x="845" y="210" />
        <di:waypoint x="892" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
