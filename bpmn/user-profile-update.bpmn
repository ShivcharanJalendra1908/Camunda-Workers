    <sequenceFlow id="Flow_UpdatePreferencesError_ToMerge" sourceRef="BoundaryError_UpdatePreferences" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_DeleteAccountError_ToMerge" sourceRef="BoundaryError_DeleteAccount" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_DeleteKeycloakError_ToMerge" sourceRef="BoundaryError_DeleteKeycloak" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_AuditError_ToMerge" sourceRef="BoundaryError_AuditLog" targetRef="Gateway_ErrorMerge" />

    <!-- Error Handler -->
    <sequenceFlow id="Flow_ToHandleError" sourceRef="Gateway_ErrorMerge" targetRef="Task_HandleError" />
    <sequenceFlow id="Flow_Error_ToEnd" sourceRef="Task_HandleError" targetRef="EndEvent_Error" />
  </process>

