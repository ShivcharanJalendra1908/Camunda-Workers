<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <process id="user-profile-update" name="User Profile Management" isExecutable="true">
    <startEvent id="StartEvent_ProfileUpdate" name="Profile Action&#10;Request">
      <outgoing>Flow_ToValidateInput</outgoing>
    </startEvent>
    <serviceTask id="Task_ValidateInput" name="Validate Input&#10;Variables">
      <extensionElements>
        <zeebe:taskDefinition type="validate-profile-data" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=action" target="action" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:input source="=sessionId" target="sessionId" />
          <zeebe:input source="=requestId" target="requestId" />
          <zeebe:output source="=isValid" target="isValid" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToValidateInput</incoming>
      <outgoing>Flow_ValidateInput_ToRouter</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_ValidateInput" name="Input&#10;Validation Error" attachedToRef="Task_ValidateInput">
      <outgoing>Flow_ValidateInputError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_ValidateInput" errorRef="Error_ValidationError" />
    </boundaryEvent>
    <exclusiveGateway id="Gateway_InputValid" name="Input&#10;Valid?" default="Flow_InputInvalid_ToError">
      <incoming>Flow_ValidateInput_ToRouter</incoming>
      <outgoing>Flow_InputValid_ToRouter</outgoing>
      <outgoing>Flow_InputInvalid_ToError</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_ActionRouter" name="Route by&#10;Action" default="Flow_ToUnsupportedAction">
      <incoming>Flow_InputValid_ToRouter</incoming>
      <outgoing>Flow_ToRetrieve</outgoing>
      <outgoing>Flow_ToUpdatePersonal</outgoing>
      <outgoing>Flow_ToUpdateProfessional</outgoing>
      <outgoing>Flow_ToUpdateCompany</outgoing>
      <outgoing>Flow_ToUpdateInvestment</outgoing>
      <outgoing>Flow_ToUpdatePreferences</outgoing>
      <outgoing>Flow_ToDeleteKeycloak</outgoing>
      <outgoing>Flow_ToUnsupportedAction</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_RetrieveProfile" name="Get Full Profile">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;GET_PROFILE&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:output source="=user" target="profile.user" />
          <zeebe:output source="=professional" target="profile.professional" />
          <zeebe:output source="=company" target="profile.company" />
          <zeebe:output source="=investment" target="profile.investment" />
          <zeebe:output source="=preferences" target="profile.preferences" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToRetrieve</incoming>
      <outgoing>Flow_Retrieve_ToMerge</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_Retrieve" name="Retrieve&#10;Error" attachedToRef="Task_RetrieveProfile">
      <outgoing>Flow_RetrieveError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_Retrieve" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdatePersonalDetails" name="Update Personal&#10;Details">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_PERSONAL&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=updatedFields" target="updatedFields" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdatePersonal</incoming>
      <outgoing>Flow_UpdatePersonal_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_UpdatePersonal" name="Personal&#10;Error" attachedToRef="Task_UpdatePersonalDetails">
      <outgoing>Flow_UpdatePersonalError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_UpdatePersonal" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdateProfessionalDetails" name="Update Professional&#10;Details">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_PROFESSIONAL&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=updatedFields" target="updatedFields" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdateProfessional</incoming>
      <outgoing>Flow_UpdateProfessional_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_UpdateProfessional" name="Professional&#10;Error" attachedToRef="Task_UpdateProfessionalDetails">
      <outgoing>Flow_UpdateProfessionalError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_UpdateProfessional" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdateCompanyDetails" name="Update Company&#10;Details">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_COMPANY&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=updatedFields" target="updatedFields" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdateCompany</incoming>
      <outgoing>Flow_UpdateCompany_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_UpdateCompany" name="Company&#10;Error" attachedToRef="Task_UpdateCompanyDetails">
      <outgoing>Flow_UpdateCompanyError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_UpdateCompany" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdateInvestmentDetails" name="Update Investment&#10;Details">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_USER_INVESTMENT&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=updatedFields" target="updatedFields" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdateInvestment</incoming>
      <outgoing>Flow_UpdateInvestment_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_UpdateInvestment" name="Investment&#10;Error" attachedToRef="Task_UpdateInvestmentDetails">
      <outgoing>Flow_UpdateInvestmentError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_UpdateInvestment" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UpdatePreferences" name="Update User&#10;Preferences">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;UPDATE_PREFERENCES&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=updatedFields" target="updatedFields" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUpdatePreferences</incoming>
      <outgoing>Flow_UpdatePreferences_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_UpdatePreferences" name="Preferences&#10;Error" attachedToRef="Task_UpdatePreferences">
      <outgoing>Flow_UpdatePreferencesError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_UpdatePreferences" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_DeleteAccount" name="Anonymize and&#10;Soft Delete Account">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;DELETE_ACCOUNT&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=profileData" target="profileData" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_DeleteKeycloak_ToAccount</incoming>
      <outgoing>Flow_DeleteAccount_ToAudit</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_DeleteAccount" name="Delete&#10;Error" attachedToRef="Task_DeleteKeycloakUser">
      <outgoing>Flow_DeleteAccountError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_DeleteAccount" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_DeleteKeycloakUser" name="Delete Keycloak&#10;User Account">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;DELETE_KEYCLOAK_USER&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:output source="=success" target="success" />
          <zeebe:output source="=message" target="message" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToDeleteKeycloak</incoming>
      <outgoing>Flow_DeleteKeycloak_ToAccount</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_DeleteKeycloak" name="Keycloak&#10;Delete Error" attachedToRef="Task_DeleteAccount">
      <outgoing>Flow_DeleteKeycloakError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_DeleteKeycloak" errorRef="Error_ActionFailed" />
    </boundaryEvent>
    <exclusiveGateway id="Gateway_NeedsAuditMerge" name="Merge&#10;Write Flows">
      <incoming>Flow_UpdatePersonal_ToAudit</incoming>
      <incoming>Flow_UpdateProfessional_ToAudit</incoming>
      <incoming>Flow_UpdateCompany_ToAudit</incoming>
      <incoming>Flow_UpdateInvestment_ToAudit</incoming>
      <incoming>Flow_UpdatePreferences_ToAudit</incoming>
      <incoming>Flow_DeleteAccount_ToAudit</incoming>
      <outgoing>Flow_MergeToAuditDecision</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_NeedsAuditDecision" name="Needs&#10;Audit?" default="Flow_AuditDecision_ToAudit">
      <incoming>Flow_MergeToAuditDecision</incoming>
      <incoming>Flow_Retrieve_ToMerge</incoming>
      <outgoing>Flow_AuditDecision_ToAudit</outgoing>
      <outgoing>Flow_AuditDecision_ToMerge</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_WriteAuditLog" name="Write Profile&#10;Audit Log">
      <extensionElements>
        <zeebe:taskDefinition type="franchise-postgres" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;INSERT_PROFILE_AUDIT&#34;" target="operation_type" />
          <zeebe:input source="=userId" target="userId" />
          <zeebe:input source="=action" target="action" />
          <zeebe:input source="=action" target="field" />
          <zeebe:input source="=profileData" target="changes" />
          <zeebe:input source="=requestId" target="request_id" />
          <zeebe:output source="=auditId" target="auditId" />
          <zeebe:output source="=errorCode" target="errorCode" />
          <zeebe:output source="=errorMessage" target="errorMessage" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_AuditDecision_ToAudit</incoming>
      <outgoing>Flow_Audit_ToSendResponse</outgoing>
    </serviceTask>
    <boundaryEvent id="BoundaryError_AuditLog" name="Audit&#10;Error" attachedToRef="Task_WriteAuditLog">
      <outgoing>Flow_AuditError_ToMerge</outgoing>
      <errorEventDefinition id="ErrorDef_AuditLog" errorRef="Error_DatabaseError" />
    </boundaryEvent>
    <serviceTask id="Task_UnsupportedAction" name="Return Unsupported&#10;Action Error">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: false, error: &#34;VALIDATION_FAILED&#34;, message: concat(&#34;Unsupported action: &#34;, action), action: action}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToUnsupportedAction</incoming>
      <outgoing>Flow_Unsupported_ToEnd</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_ResponseMerge" name="Merge&#10;Before Response">
      <incoming>Flow_AuditDecision_ToMerge</incoming>
      <incoming>Flow_Audit_ToSendResponse</incoming>
      <outgoing>Flow_ToSendResponse</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_SendResponse" name="Send API&#10;Response">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: success, message: message, action: action, data: {profile: if action = &#34;retrieve&#34; then profile else profileData, updatedFields: updatedFields, auditId: auditId}}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToSendResponse</incoming>
      <outgoing>Flow_ToEnd</outgoing>
    </serviceTask>
    <exclusiveGateway id="Gateway_ErrorMerge" name="Error&#10;Merge">
      <incoming>Flow_ValidateInputError_ToMerge</incoming>
      <incoming>Flow_InputInvalid_ToError</incoming>
      <incoming>Flow_RetrieveError_ToMerge</incoming>
      <incoming>Flow_UpdatePersonalError_ToMerge</incoming>
      <incoming>Flow_UpdateProfessionalError_ToMerge</incoming>
      <incoming>Flow_UpdateCompanyError_ToMerge</incoming>
      <incoming>Flow_UpdateInvestmentError_ToMerge</incoming>
      <incoming>Flow_UpdatePreferencesError_ToMerge</incoming>
      <incoming>Flow_DeleteAccountError_ToMerge</incoming>
      <incoming>Flow_DeleteKeycloakError_ToMerge</incoming>
      <incoming>Flow_AuditError_ToMerge</incoming>
      <outgoing>Flow_ToHandleError</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_HandleError" name="Send Error&#10;Response">
      <extensionElements>
        <zeebe:taskDefinition type="send-api-response" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="=correlationKey" target="correlationKey" />
          <zeebe:input source="={success: false, error: if errorCode != null then errorCode else &#34;INTERNAL_ERROR&#34;, message: if errorMessage != null then errorMessage else &#34;An unexpected error occurred&#34;, action: action}" target="response" />
        </zeebe:ioMapping>
      </extensionElements>
      <incoming>Flow_ToHandleError</incoming>
      <outgoing>Flow_Error_ToEnd</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_Success" name="Action&#10;Completed">
      <incoming>Flow_ToEnd</incoming>
    </endEvent>
    <endEvent id="EndEvent_Error" name="Action&#10;Failed">
      <incoming>Flow_Error_ToEnd</incoming>
      <incoming>Flow_Unsupported_ToEnd</incoming>
    </endEvent>
    <sequenceFlow id="Flow_ToValidateInput" sourceRef="StartEvent_ProfileUpdate" targetRef="Task_ValidateInput" />
    <sequenceFlow id="Flow_ValidateInput_ToRouter" sourceRef="Task_ValidateInput" targetRef="Gateway_InputValid" />
    <sequenceFlow id="Flow_InputValid_ToRouter" name="Valid" sourceRef="Gateway_InputValid" targetRef="Gateway_ActionRouter">
      <conditionExpression xsi:type="tFormalExpression">=isValid = true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_InputInvalid_ToError" name="Invalid" sourceRef="Gateway_InputValid" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ToRetrieve" name="retrieve" sourceRef="Gateway_ActionRouter" targetRef="Task_RetrieveProfile">
      <conditionExpression xsi:type="tFormalExpression">=action = "retrieve"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdatePersonal" name="update_personal" sourceRef="Gateway_ActionRouter" targetRef="Task_UpdatePersonalDetails">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_personal"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdateProfessional" name="update_professional" sourceRef="Gateway_ActionRouter" targetRef="Task_UpdateProfessionalDetails">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_professional"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdateCompany" name="update_company" sourceRef="Gateway_ActionRouter" targetRef="Task_UpdateCompanyDetails">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_company"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdateInvestment" name="update_investment" sourceRef="Gateway_ActionRouter" targetRef="Task_UpdateInvestmentDetails">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_investment"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUpdatePreferences" name="update_preferences" sourceRef="Gateway_ActionRouter" targetRef="Task_UpdatePreferences">
      <conditionExpression xsi:type="tFormalExpression">=action = "update_preferences"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToDeleteKeycloak" name="delete_account" sourceRef="Gateway_ActionRouter" targetRef="Task_DeleteKeycloakUser">
      <conditionExpression xsi:type="tFormalExpression">=action = "delete_account"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToUnsupportedAction" name="default" sourceRef="Gateway_ActionRouter" targetRef="Task_UnsupportedAction" />
    <sequenceFlow id="Flow_Retrieve_ToMerge" sourceRef="Task_RetrieveProfile" targetRef="Gateway_NeedsAuditDecision" />
    <sequenceFlow id="Flow_UpdatePersonal_ToAudit" sourceRef="Task_UpdatePersonalDetails" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_UpdateProfessional_ToAudit" sourceRef="Task_UpdateProfessionalDetails" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_UpdateCompany_ToAudit" sourceRef="Task_UpdateCompanyDetails" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_UpdateInvestment_ToAudit" sourceRef="Task_UpdateInvestmentDetails" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_UpdatePreferences_ToAudit" sourceRef="Task_UpdatePreferences" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_DeleteAccount_ToAudit" sourceRef="Task_DeleteAccount" targetRef="Gateway_NeedsAuditMerge" />
    <sequenceFlow id="Flow_MergeToAuditDecision" sourceRef="Gateway_NeedsAuditMerge" targetRef="Gateway_NeedsAuditDecision" />
    <sequenceFlow id="Flow_AuditDecision_ToAudit" name="Write audit log" sourceRef="Gateway_NeedsAuditDecision" targetRef="Task_WriteAuditLog">
      <conditionExpression xsi:type="tFormalExpression">=action != "retrieve"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_AuditDecision_ToMerge" name="Skip audit" sourceRef="Gateway_NeedsAuditDecision" targetRef="Gateway_ResponseMerge">
      <conditionExpression xsi:type="tFormalExpression">=action = "retrieve"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_DeleteKeycloak_ToAccount" sourceRef="Task_DeleteKeycloakUser" targetRef="Task_DeleteAccount" />
    <sequenceFlow id="Flow_Audit_ToSendResponse" sourceRef="Task_WriteAuditLog" targetRef="Gateway_ResponseMerge" />
    <sequenceFlow id="Flow_ToSendResponse" sourceRef="Gateway_ResponseMerge" targetRef="Task_SendResponse" />
    <sequenceFlow id="Flow_ToEnd" sourceRef="Task_SendResponse" targetRef="EndEvent_Success" />
    <sequenceFlow id="Flow_Unsupported_ToEnd" sourceRef="Task_UnsupportedAction" targetRef="EndEvent_Error" />
    <sequenceFlow id="Flow_ValidateInputError_ToMerge" sourceRef="BoundaryError_ValidateInput" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_RetrieveError_ToMerge" sourceRef="BoundaryError_Retrieve" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_UpdatePersonalError_ToMerge" sourceRef="BoundaryError_UpdatePersonal" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_UpdateProfessionalError_ToMerge" sourceRef="BoundaryError_UpdateProfessional" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_UpdateCompanyError_ToMerge" sourceRef="BoundaryError_UpdateCompany" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_UpdateInvestmentError_ToMerge" sourceRef="BoundaryError_UpdateInvestment" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_UpdatePreferencesError_ToMerge" sourceRef="BoundaryError_UpdatePreferences" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_DeleteAccountError_ToMerge" sourceRef="BoundaryError_DeleteAccount" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_DeleteKeycloakError_ToMerge" sourceRef="BoundaryError_DeleteKeycloak" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_AuditError_ToMerge" sourceRef="BoundaryError_AuditLog" targetRef="Gateway_ErrorMerge" />
    <sequenceFlow id="Flow_ToHandleError" sourceRef="Gateway_ErrorMerge" targetRef="Task_HandleError" />
    <sequenceFlow id="Flow_Error_ToEnd" sourceRef="Task_HandleError" targetRef="EndEvent_Error" />
  </process>
  <error id="Error_DatabaseError" name="Database Error" errorCode="DATABASE_ERROR" />
  <error id="Error_ValidationError" name="Validation Error" errorCode="VALIDATION_FAILED" />
  <error id="Error_ActionFailed" name="Action Failed" errorCode="ACTION_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="user-profile-update">
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent_ProfileUpdate">
        <dc:Bounds x="170" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="515" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ValidateInput" bpmnElement="Task_ValidateInput">
        <dc:Bounds x="270" y="450" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateCompanyDetails" bpmnElement="Task_UpdateCompanyDetails">
        <dc:Bounds x="660" y="456" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_NeedsAuditMerge" bpmnElement="Gateway_NeedsAuditMerge" isMarkerVisible="true">
        <dc:Bounds x="885" y="471" width="50" height="50" />
