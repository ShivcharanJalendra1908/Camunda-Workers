# --- Application Configuration ---
APP_NAME=camunda-workers
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# --- API Gateway Configuration ---
API_PORT=8080
API_HOST=0.0.0.0
API_READ_TIMEOUT=30
API_WRITE_TIMEOUT=30
API_IDLE_TIMEOUT=120

# --- Camunda/Zeebe Configuration ---
# ✅ FIXED: Add both names for compatibility
ZEEBE_ADDRESS=zeebe:26500
CAMUNDA_BROKER_ADDRESS=localhost:26500
CAMUNDA_GATEWAY_ADDRESS=localhost:26500
CAMUNDA_INSECURE=true

# --- PostgreSQL Configuration ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=franchises
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# ✅ FIXED: Add DATABASE_ prefix versions for config loader
DATABASE_POSTGRES_HOST=localhost
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_DATABASE=franchises
DATABASE_POSTGRES_USER=postgres
DATABASE_POSTGRES_PASSWORD=postgres
DATABASE_POSTGRES_SSL_MODE=disable
DATABASE_POSTGRES_MAX_CONNECTIONS=25
DATABASE_POSTGRES_MAX_IDLE=5

